{
  "name": "@zsm3/worker",
  "private": true,
  "type": "module",
  "scripts": {
    "types": "wrangler types",
    "typecheck": "wrangler types --check && tsc -p tsconfig.json && tsc -p test/node/tsconfig.json && tsc -p seed/tsconfig.json",
    "test": "vitest run --coverage",
    "test:mutation": "stryker run",
    "seed": "node seed/seed.ts ../web/wrangler.jsonc ../web/.wrangler/state/v3"
  },
  "dependencies": {
    "@zsm3/contracts": "workspace:*",
    "hono": "4.13.13",
    "jose": "6.2.13",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/typescript-checker": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "4.151.3"
  },
  "exports": {
    "./app": "./src/app.ts",
    "./env": "./src/env.ts",
    "./jobs/retention": "./src/jobs/retention.ts",
    "./requests-app": "./src/requests-app.ts",
    "./short-links/*": "./src/short-links/*",
    "./storage/*": "./src/storage/*",
    "./seed/files.ts": "./seed/files.ts",
    "./seed/pages/index.ts": "./seed/pages/index.ts",
    "./seed/calendar/index.ts": "./seed/calendar/index.ts",
    "./seed/datasets/index.ts": "./seed/datasets/index.ts"
  }
}
