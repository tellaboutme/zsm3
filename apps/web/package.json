{
  "name": "@zsm3/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --mode preview",
    "build": "astro build",
    "build:preview": "astro build --mode preview",
    "typecheck": "astro check && wrangler types worker/worker-configuration.d.ts --include-env=false --check && tsc -p worker/tsconfig.json",
    "test": "vitest run --coverage",
    "test:mutation": "stryker run",
    "db:migrate": "wrangler d1 migrations apply DB --local --persist-to .wrangler/state",
    "start": "wrangler dev -c dist/server/wrangler.json --persist-to .wrangler/state --ip 127.0.0.1 --port 8787 --var ACCESS_TEAM_DOMAIN:http://127.0.0.1:8799 --var ACCESS_AUDIENCE:zsm3-dev --var PANEL_ORIGIN:http://127.0.0.1:8787"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.4",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/source-sans-3": "5.3.1",
    "@fontsource/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@zsm3/contracts": "workspace:*",
    "@zsm3/worker": "workspace:*",
    "astro": "7.4.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/typescript-checker": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "fast-check": "catalog:",
    "happy-dom": "21.0.4",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "4.151.3"
  }
}
