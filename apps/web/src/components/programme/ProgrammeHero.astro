---
import { fieldLabels, type Profession } from "../../lib/professions.ts";
import { programmeFacts, schoolNames, type Programme } from "../../lib/programmes.ts";
import FactStrip from "../FactStrip.astro";

interface Props {
  programme: Programme;
  profession: Profession;
}

const { programme, profession } = Astro.props;
const [first = "", ...rest] = profession.name.split(" ");
---

<header class="hero">
  <p class="tag">
    {fieldLabels[profession.field]} · {schoolNames[programme.school]}
  </p>
  <h1>
    <span class="rise">
      <span>{first}</span>
    </span>
    {rest.length > 0 && (
      <span class="rise">
        <span>{rest.join(" ")}</span>
      </span>
    )}
  </h1>
  <p class="lead">{programme.lead}</p>
  <FactStrip label="Kierunek w liczbach" facts={programmeFacts(programme, profession)} />
</header>

<style>
  .hero {
    display: grid;
    gap: var(--space-5);
    padding-top: var(--space-7);
    container-type: inline-size;
  }

  .tag {
    color: var(--ink-2);
  }

  h1 {
    font-size: max(min(var(--step-4), 6.5cqi), var(--step-2));
    font-stretch: var(--stretch-wide);
    hyphens: auto;
    text-transform: uppercase;
  }

  .lead {
    max-width: var(--measure);
    font-size: var(--step-1);
    line-height: var(--leading-snug);
  }
</style>
