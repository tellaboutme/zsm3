---
import type { Topic } from "../../lib/programmes.ts";

interface Props {
  topics: readonly Topic[];
  numbered?: boolean;
}

const { topics, numbered = false } = Astro.props;
---

<ol class:list={["topics", { numbered }]}>
  {topics.map((topic, index) => (
    <li class="reveal">
      {numbered && <span class="tag number">{String(index + 1).padStart(2, "0")}</span>}
      <h3>{topic.title}</h3>
      <p>{topic.text}</p>
    </li>
  ))}
</ol>

<style>
  .topics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: var(--space-5) var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    padding-top: var(--space-3);
    border-top: var(--hairline) solid var(--line);
  }

  .numbered li {
    border-top: var(--rule) solid var(--orange);
  }

  .number {
    color: var(--ink-2);
    font-weight: 600;
  }

  h3 {
    font-size: var(--step-1);
    line-height: var(--leading-snug);
  }

  p {
    color: var(--ink-2);
  }
</style>
