---
import type { Exam } from "../../lib/programmes.ts";

interface Props {
  exams: readonly Exam[];
}

const { exams } = Astro.props;
---

<ol class="exams">
  {exams.map((exam) => (
    <li>
      <p class="codes">
        <span class="code">{exam.code}</span>
        {exam.alternative !== undefined && (
          <>
            <span class="or">lub</span>
            <span class="code">{exam.alternative.code}</span>
          </>
        )}
      </p>
      <h3>
        {exam.name}
        {exam.alternative !== undefined && ` lub ${exam.alternative.name.toLowerCase()}`}
      </h3>
      <p class="scope">{exam.scope}</p>
    </li>
  ))}
</ol>

<style>
  .exams {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    padding: var(--space-5);
    border-radius: var(--radius);
    background: var(--blue);
    color: var(--blue-ink);
  }

  .codes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: baseline;
  }

  .code {
    font-family: var(--font-mono);
    font-size: var(--step-2);
    font-weight: 600;
  }

  .or,
  .scope {
    color: var(--blue-dim);
  }

  h3 {
    font-size: var(--step-1);
    line-height: var(--leading-snug);
  }
</style>
