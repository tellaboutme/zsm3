---
import type { MapNode } from "../lib/site-map.ts";

interface Props {
  nodes: readonly MapNode[];
  depth?: number;
}

const { nodes, depth = 0 } = Astro.props;
---

<ul class:list={["tree", { root: depth === 0 }]}>
  {nodes.map((node) => (
    <li>
      <a href={node.href}>{node.label}</a>
      {node.description !== undefined && depth < 2 && <p>{node.description}</p>}
      {node.children !== undefined && node.children.length > 0 && (
        <Astro.self nodes={node.children} depth={depth + 1} />
      )}
    </li>
  ))}
</ul>

<style>
  .tree {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding-left: var(--space-5);
    border-left: var(--hairline) solid var(--line);
    list-style: none;
  }

  li {
    display: grid;
    gap: var(--space-1);
  }

  a {
    font-weight: 700;
  }

  p {
    color: var(--ink-2);
    font-size: var(--step-n1);
  }

  .root {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    gap: var(--space-6) var(--space-5);
    padding-left: 0;
    border-left: 0;
  }

  .root > li {
    align-content: start;
    padding-top: var(--space-3);
    border-top: var(--rule) solid var(--ink);
  }

  .root > li > a {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 800;
  }
</style>
