---
interface Props {
  size?: "panel" | "large";
}

const { size = "panel" } = Astro.props;
---

<section class:list={["live", size]} data-live-status aria-label="Teraz w szkole">
  <div class="top">
    <p class="tag">Teraz w szkole</p>
    <a class="tag bells" href="/uczniowie/dzwonki">
      Dzwonki
    </a>
  </div>
  <div class="main">
    <div class="status">
      <p class="title" data-live="title">
        Dzwonki
      </p>
      <p class="detail" data-live="detail">
        1. lekcja o 7:30
      </p>
    </div>
    <p class="timer" data-live="timer">
      —
    </p>
  </div>
  <progress max="1" value="0" aria-label="Postęp bieżącej lekcji"></progress>
</section>

<style>
  .live {
    display: grid;
    container-type: inline-size;
    gap: var(--space-4);
    padding: var(--space-5);
    border-radius: var(--radius);
    background: var(--blue);
    color: var(--blue-ink);
  }

  .top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    color: var(--blue-dim);
  }

  .bells {
    display: inline-flex;
    align-items: center;
    min-height: var(--space-6);
    color: var(--blue-ink);
    font-weight: 700;
    text-decoration-thickness: var(--hairline);
    text-underline-offset: 0.25em;
  }

  .live :focus-visible {
    outline-color: var(--blue-ink);
  }

  .main {
    display: grid;
    gap: var(--space-3);
  }

  .status {
    display: grid;
    gap: var(--space-1);
    min-width: 0;
  }

  .title {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-stretch: var(--stretch-display);
    font-weight: 800;
    line-height: var(--leading-tight);
  }

  .detail {
    color: var(--blue-dim);
  }

  .timer {
    font-family: var(--font-mono);
    font-size: min(var(--step-3), 14cqi);
    font-variant-numeric: tabular-nums;
    line-height: var(--leading-tight);
    white-space: nowrap;
  }

  progress {
    width: 100%;
    min-width: 0;
    height: var(--space-2);
    border: var(--hairline) solid var(--progress-edge);
    border-radius: var(--radius);
    appearance: none;
    background: var(--progress-track);
    accent-color: var(--blue-ink);
  }

  progress::-webkit-progress-bar {
    border-radius: var(--radius);
    background: var(--progress-track);
  }

  progress::-webkit-progress-value {
    border-radius: var(--radius);
    background: var(--blue-ink);
  }

  progress::-moz-progress-bar {
    border-radius: var(--radius);
    background: var(--blue-ink);
  }

  @container (width >= 24rem) {
    .main {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      column-gap: var(--space-5);
    }

    .timer {
      text-align: end;
    }
  }

  .large {
    padding: var(--space-6);
  }

  .large .title {
    font-size: var(--step-3);
  }

  .large .timer {
    font-size: min(var(--step-4), 18cqi);
  }
</style>
