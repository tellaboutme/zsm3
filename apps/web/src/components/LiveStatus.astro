<section class="live" data-live-status aria-label="Teraz w szkole">
  <div class="top">
    <p class="label">Teraz w szkole</p>
    <a class="bells nudge" href="/uczniowie/dzwonki">
      Dzwonki <span aria-hidden="true">→</span>
    </a>
  </div>
  <div class="main">
    <div class="status">
      <p class="title" data-live="title">
        Dzwonki
      </p>
      <p class="detail" data-live="detail">
        1. lekcja o 7:30
      </p>
      <span class="title sizer" aria-hidden="true">
        Teraz nie ma lekcji
      </span>
      <span class="detail sizer" aria-hidden="true">
        Następne lekcje w poniedziałek 30 października o 10:45
      </span>
    </div>
    <p class="timer" data-live="timer">
      —
    </p>
  </div>
  <progress max="1" value="0" aria-label="Postęp bieżącej lekcji"></progress>
</section>

<style>
  .live {
    position: relative;
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-5) var(--space-5);
    border: var(--hairline) solid var(--line);
    border-left: var(--rule) solid var(--blue);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
  }

  .top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-1) var(--space-3);
  }

  .label {
    color: var(--ink-2);
    font-size: var(--step-n1);
  }

  .bells {
    display: inline-flex;
    gap: var(--space-1);
    align-items: center;
    min-height: var(--space-6);
    font-size: var(--step-n1);
    font-weight: 700;
  }

  .main {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--space-2) var(--space-5);
  }

  .status {
    display: grid;
    flex: 1 1 auto;
    gap: var(--space-1);
    min-width: 0;
  }

  .title {
    grid-area: 1 / 1;
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: var(--weight-heading);
    line-height: var(--leading-snug);
  }

  .detail {
    grid-area: 2 / 1;
    color: var(--ink-2);
    font-size: var(--step-0);
  }

  .sizer {
    visibility: hidden;
  }

  .timer {
    color: var(--link);
    font-family: var(--font-mono);
    font-size: var(--step-3);
    font-variant-numeric: tabular-nums;
    line-height: var(--leading-tight);
    min-inline-size: 7ch;
    white-space: nowrap;
  }

  progress {
    position: absolute;
    right: var(--space-5);
    bottom: var(--space-3);
    left: var(--space-5);
    width: auto;
    height: var(--space-1);
    border: 0;
    border-radius: var(--radius);
    appearance: none;
    background: var(--line);
    accent-color: var(--blue);
  }

  progress::-webkit-progress-bar {
    border-radius: var(--radius);
    background: var(--line);
  }

  progress::-webkit-progress-value {
    border-radius: var(--radius);
    background: var(--blue);
  }

  progress::-moz-progress-bar {
    border-radius: var(--radius);
    background: var(--blue);
  }

  [data-state="after"] :is(.timer, progress),
  [data-state="day-off"] :is(.timer, progress) {
    visibility: hidden;
  }
</style>
