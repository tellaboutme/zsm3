---
import type { Fact } from "../lib/programmes.ts";

interface Props {
  label: string;
  facts: readonly Fact[];
}

const { label, facts } = Astro.props;
---

<section class="facts" aria-label={label}>
  <dl>
    {facts.map((fact) => (
      <div class="item reveal">
        <dt>{fact.label}</dt>
        <dd>{fact.value}</dd>
      </div>
    ))}
  </dl>
</section>

<style>
  dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    margin: 0;
    border-block: var(--hairline) solid var(--line);
  }

  .item {
    display: flex;
    flex-direction: column-reverse;
    gap: var(--space-2);
    justify-content: start;
    min-width: 0;
    padding: var(--space-5) var(--space-4);
    container-type: inline-size;
    border-bottom: var(--hairline) solid var(--line);
  }

  dd {
    margin: 0;
    overflow-wrap: break-word;
    color: var(--link);
    font-family: var(--font-display);
    font-size: min(var(--step-3), 14cqi);
    font-stretch: var(--stretch-wide);
    font-weight: 900;
    line-height: var(--leading-tight);
  }

  dt {
    max-width: 22ch;
    color: var(--ink-2);
  }

  @media (width >= 56rem) {
    .item {
      border-bottom: 0;
    }

    .item + .item {
      border-left: var(--hairline) solid var(--line);
    }
  }
</style>
