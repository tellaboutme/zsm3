---
import LiveStatus from "./LiveStatus.astro";
import { isoDay, longDate, nextEvent } from "../lib/calendar.ts";
import type { Featured } from "../lib/navigation.ts";

interface Props {
  feature: Featured;
}

const { feature } = Astro.props;
const meeting = nextEvent(Astro.locals.events ?? [], isoDay(new Date()), "Rodzice");
---

{feature === "live-status" && <LiveStatus />}
{feature === "professions" && (
  <a class="feature nudge" href="/kandydaci/zawody">
    <span class="label">Oferta</span>
    <span class="big">13 zawodów</span>
    <span>w technikum i szkole branżowej, w pięciu branżach</span>
    <span class="go" aria-hidden="true">
      →
    </span>
  </a>
)}
{feature === "next-meeting" && (
  <a class="feature nudge" href="/szkola/terminarz" data-dated>
    <span class="label">Najbliższe zebranie z rodzicami</span>
    <span class="big">{meeting === undefined ? "Terminarz" : longDate(meeting.date)}</span>
    <span>Terminy wszystkich spotkań w terminarzu roku szkolnego</span>
    <span class="go" aria-hidden="true">
      →
    </span>
  </a>
)}
{feature === "patron" && (
  <a class="feature nudge" href="/szkola/patron">
    <span class="label">Patron szkoły</span>
    <span class="big">gen. Władysław Sikorski</span>
    <span>Historia patrona i tradycje szkoły</span>
    <span class="go" aria-hidden="true">
      →
    </span>
  </a>
)}

<style>
  .feature {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    height: 100%;
    padding: var(--space-5);
    border: var(--hairline) solid var(--line);
    border-left: var(--rule) solid var(--blue);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
    transition: border-color var(--duration-2) var(--ease);
  }

  .feature:hover {
    border-color: var(--blue);
  }

  .label {
    color: var(--ink-2);
    font-size: var(--step-n1);
  }

  .big {
    color: var(--link);
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: var(--weight-heading);
    line-height: var(--leading-snug);
  }

  .go {
    color: var(--link);
    font-weight: 700;
  }
</style>
