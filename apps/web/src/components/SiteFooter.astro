---
import EmailText from "./EmailText.astro";
import { publicFallbackNavigation } from "../data/navigation.ts";
import { school } from "../data/site.ts";

const { footerGroups } = Astro.locals.navigation ?? publicFallbackNavigation;
---

<footer class="site-footer">
  <div class="page inner">
    <section class="identity" aria-labelledby="stopka-szkola">
      <img class="mark" src="/logo-zsm3.png" alt="" width="112" height="112" loading="lazy" />
      <h2 id="stopka-szkola">
        {school.name} im.&nbsp;{school.patron}
      </h2>
      <address>
        {school.street}
        <br />
        {school.postalCode}&nbsp;{school.city}
        <br />
        <a class="tap-target" href={school.mapUrl} rel="external">
          Mapa dojazdu
        </a>
      </address>
    </section>
    <section aria-labelledby="stopka-kontakt">
      <h2 id="stopka-kontakt" class="label">
        Sekretariat
      </h2>
      <address>
        <a class="tap-target" href={`tel:${school.phone}`}>
          {school.phoneLabel} wew. {school.secretariatExtension}
        </a>
        <br />
        <a class="tap-target" href={`mailto:${school.email}`}>
          <EmailText email={school.email} />
        </a>
        <br />
        <a class="tap-target" href={`mailto:${school.officeEmail}`}>
          <EmailText email={school.officeEmail} />
        </a>
      </address>
    </section>
    {footerGroups.map((group) => (
      <div>
        <h2 class="label">{group.title}</h2>
        <ul>
          {group.links.map((link) => (
            <li>
              <a
                class="tap-target"
                href={link.href}
                rel={link.external === true ? "external" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
  <div class="page legal">
    <p>Organ prowadzący: {school.owner}</p>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-7) var(--space-5);
    background: var(--blue-2);
    color: var(--blue-ink);
  }

  .inner {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: var(--space-6);
  }

  .identity {
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }

  .mark {
    width: var(--space-8);
    height: var(--space-8);
  }

  .identity h2 {
    font-family: var(--font-body);
    font-size: var(--step-0);
    font-stretch: 100%;
    font-weight: 700;
    line-height: var(--leading-snug);
  }

  .label {
    margin-bottom: var(--space-3);
    color: var(--blue-dim);
    font-family: var(--font-body);
    font-size: var(--step-n1);
    font-weight: 600;
    letter-spacing: 0;
  }

  address {
    font-style: normal;
    overflow-wrap: anywhere;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    color: var(--blue-ink);
    text-decoration: none;
  }

  li > a {
    display: flex;
    align-items: center;
    padding-block: 0;
  }

  a:hover,
  a:focus-visible {
    text-decoration: underline;
  }

  .legal {
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: var(--hairline) solid var(--blue);
    color: var(--blue-dim);
    font-size: var(--step-n1);
  }
</style>
