---
import Icon from "./Icon.astro";

import "../styles/settings.css";

const switches = [
  { name: "contrast", value: "high", label: "Wysoki kontrast", hint: "Mocniejsze różnice barw." },
  { name: "font", value: "readable", label: "Czytelny krój pisma", hint: "Atkinson Hyperlegible." },
  { name: "underline", value: "on", label: "Podkreślaj linki", hint: "Linki zawsze podkreślone." },
  { name: "grayscale", value: "on", label: "Skala szarości", hint: "Strona bez kolorów." },
  {
    name: "motion",
    value: "reduce",
    label: "Ogranicz animacje",
    hint: "Wyłącza przejścia i efekty wejścia treści.",
  },
] as const;
const textSizes = [
  { value: "", label: "Standardowy" },
  { value: "125", label: "Większy" },
  { value: "150", label: "Największy" },
] as const;
const themes = [
  { value: "", label: "Systemowy" },
  { value: "light", label: "Jasny" },
  { value: "dark", label: "Ciemny" },
] as const;
const backgrounds = [
  { value: "", label: "Ruchome" },
  { value: "static", label: "Statyczne" },
] as const;
---

<dialog class="settings" aria-labelledby="ustawienia-tytul" data-settings-dialog>
  <div class="panel" data-settings-form>
    <div class="head">
      <div class="titles">
        <p class="kicker">Ustawienia</p>
        <h2 id="ustawienia-tytul">Wygląd i dostępność</h2>
      </div>
      <button type="button" class="icon-button" data-close-dialog>
        <Icon name="close" />
        <span class="visually-hidden">Zamknij ustawienia</span>
      </button>
    </div>
    <p class="note">Zmiany działają od razu i zostają zapamiętane w tej przeglądarce.</p>
    <fieldset class="segmented">
      <legend>Wielkość tekstu</legend>
      <div class="segments">
        {textSizes.map((size) => (
          <label class="segment">
            <input type="radio" name="text" value={size.value} />
            <span>{size.label}</span>
          </label>
        ))}
      </div>
    </fieldset>
    <fieldset class="segmented">
      <legend>Motyw</legend>
      <div class="segments">
        {themes.map((theme) => (
          <label class="segment">
            <input type="radio" name="theme" value={theme.value} />
            <span>{theme.label}</span>
          </label>
        ))}
      </div>
    </fieldset>
    <fieldset class="segmented">
      <legend>Tło strony</legend>
      <div class="segments">
        {backgrounds.map((option) => (
          <label class="segment">
            <input type="radio" name="background" value={option.value} />
            <span>{option.label}</span>
          </label>
        ))}
      </div>
    </fieldset>
    <fieldset class="toggles">
      <legend>Ułatwienia</legend>
      {switches.map((item) => (
        <label class="toggle">
          <input type="checkbox" name={item.name} value={item.value} />
          <span class="toggle-label">{item.label}</span>
          <span class="toggle-hint">{item.hint}</span>
          <span class="track" aria-hidden="true"></span>
        </label>
      ))}
    </fieldset>
    <div class="actions">
      <button type="button" class="secondary" data-reset-settings>
        Przywróć domyślne
      </button>
      <button type="button" class="primary" data-close-dialog>
        Gotowe
      </button>
    </div>
  </div>
</dialog>
