---
import type { SchoolEvent } from "../../lib/calendar.ts";
import { datePlaque } from "../../lib/date-plaque.ts";
import DateRange from "../DateRange.astro";

interface Props {
  events: readonly SchoolEvent[];
}

const { events } = Astro.props;
---

<section class="key-dates" aria-labelledby="najwazniejsze">
  <h2 id="najwazniejsze">Najważniejsze daty</h2>
  <ol>
    {events.map((event) => {
      const plaque = datePlaque(event.date, event.endDate);
      return (
        <li>
          <span class:list={["plaque", { range: plaque.range }]} aria-hidden="true">
            <span class="day">{plaque.day}</span>
            <span class="month">{plaque.month}</span>
          </span>
          <div class="body">
            <p class="when visually-hidden">
              <DateRange date={event.date} endDate={event.endDate} />
            </p>
            <p class="what">{event.title}</p>
          </div>
        </li>
      );
    })}
  </ol>
</section>

<style>
  .key-dates {
    display: grid;
    gap: var(--space-5);
  }

  h2 {
    font-size: var(--step-3);
  }

  ol {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0 var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr);
    gap: var(--space-4);
    align-items: center;
    padding-block: var(--space-3);
    border-top: var(--hairline) solid var(--line);
  }

  .plaque {
    display: grid;
    justify-items: center;
    align-content: center;
    min-height: 4rem;
    padding: var(--space-2) var(--space-1);
    border: var(--hairline) solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--link);
    font-family: var(--font-mono);
    line-height: var(--leading-tight);
    text-align: center;
  }

  .day {
    font-size: var(--step-1);
    font-variant-numeric: tabular-nums;
    font-weight: 700;
  }

  .range .day {
    font-size: var(--step-n1);
  }

  .month {
    font-size: var(--step-n1);
    text-transform: uppercase;
  }

  .body {
    min-width: 0;
  }

  .what {
    font-weight: 700;
    line-height: var(--leading-snug);
  }

  @media (width >= 40rem) {
    ol {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (width >= 64rem) {
    ol {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
