---
import { longDate } from "../../lib/calendar.ts";
import { newsHref, type NewsItem } from "../../lib/news.ts";

interface Props {
  item: NewsItem;
  variant?: "lead" | "standard" | "compact";
  headingLevel?: 2 | 3;
}

const { item, variant = "standard", headingLevel = 3 } = Astro.props;
const Heading = headingLevel === 2 ? "h2" : "h3";
---

<article class:list={["card", variant]}>
  <p class="meta">
    <time datetime={item.date}>{longDate(item.date)}</time>
    {variant !== "compact" && <span class="category">{item.category}</span>}
  </p>
  <Heading class="title">
    <a href={newsHref(item)}>{item.title}</a>
  </Heading>
  {variant !== "compact" && <p class="summary">{item.lead}</p>}
  {variant === "lead" && item.cover !== undefined && <p class="caption">{item.cover.caption}</p>}
</article>

<style>
  .card {
    position: relative;
    display: grid;
    gap: var(--space-2);
    align-content: start;
    height: 100%;
    padding: var(--space-4) var(--space-5) var(--space-5);
    border: var(--hairline) solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    transition: border-color var(--duration-2) var(--ease);
  }

  .card:hover {
    border-color: var(--blue);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    color: var(--ink-2);
    font-size: var(--step-n1);
  }

  .title {
    font-size: var(--step-1);
    line-height: var(--leading-snug);
  }

  .title a {
    color: var(--ink);
    text-decoration: none;
  }

  .title a::after {
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
    content: "";
  }

  .card:hover .title a {
    color: var(--link);
    text-decoration: underline;
  }

  .summary {
    display: -webkit-box;
    overflow: hidden;
    color: var(--ink-2);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .caption {
    color: var(--ink-2);
    font-size: var(--step-n1);
  }

  .card.lead {
    gap: var(--space-3);
    padding: var(--space-5) var(--space-6) var(--space-6);
  }

  .card.lead .title {
    font-size: var(--step-3);
    line-height: var(--leading-tight);
  }

  .card.lead .summary {
    max-width: var(--measure);
    font-size: var(--step-1);
    -webkit-line-clamp: 4;
  }

  .card.compact {
    padding: var(--space-3) var(--space-4);
  }
</style>
