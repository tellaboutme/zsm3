---
import { longDate } from "../../lib/calendar.ts";
import { newsHref, type NewsItem } from "../../lib/news.ts";
import MediaPlaceholder from "../MediaPlaceholder.astro";

interface Props {
  item: NewsItem;
  variant?: "lead" | "standard" | "compact";
  headingLevel?: 2 | 3;
}

const { item, variant = "standard", headingLevel = 3 } = Astro.props;
const Heading = headingLevel === 2 ? "h2" : "h3";
const cover = variant === "compact" ? undefined : item.cover;
---

<article class:list={["card", variant]}>
  {cover !== undefined && <MediaPlaceholder shape="wide" caption={cover.caption} />}
  <div class="text">
    <p class="tag meta">
      <time datetime={item.date}>{longDate(item.date)}</time>
      {variant !== "compact" && <span> · {item.category}</span>}
    </p>
    <Heading class="title">
      <a href={newsHref(item)}>{item.title}</a>
    </Heading>
    {variant !== "compact" && <p class="lead">{item.lead}</p>}
  </div>
</article>

<style>
  .card {
    position: relative;
    display: grid;
    gap: var(--space-4);
    align-content: start;
    padding-top: var(--space-4);
    border-top: var(--hairline) solid var(--line);
  }

  .text {
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }

  .meta {
    color: var(--ink-2);
  }

  .title {
    font-size: var(--step-1);
    line-height: var(--leading-snug);
  }

  .title a {
    color: var(--ink);
    text-decoration: none;
  }

  .title a::after {
    position: absolute;
    inset: 0;
    content: "";
  }

  .card:hover .title a {
    color: var(--link);
    text-decoration: underline;
  }

  .lead {
    color: var(--ink-2);
  }

  .card.lead {
    padding-top: var(--space-5);
    border-top: var(--rule) solid var(--orange);
  }

  .card.lead .title {
    font-size: var(--step-3);
    line-height: var(--leading-tight);
  }

  .card.lead .lead {
    max-width: var(--measure);
    font-size: var(--step-1);
  }

  .card.compact {
    gap: var(--space-2);
  }
</style>
