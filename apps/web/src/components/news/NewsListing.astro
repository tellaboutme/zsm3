---
import NewsCard from "./NewsCard.astro";
import Pagination from "./Pagination.astro";
import type { Listing } from "../../lib/news-listing.ts";
import { categoryHref } from "../../lib/news.ts";

interface Props {
  listing: Listing;
  base: string;
  heading: string;
  year?: string | undefined;
}

const { listing, base, heading, year } = Astro.props;
const current = listing.page;
const page = current.page;
const category = listing.category?.slug;
const lead = page === 1 ? current.items[0] : undefined;
const rest = lead === undefined ? current.items : current.items.slice(1);
const unfiltered = category === undefined && year === undefined;
---

<div class="listing">
  <header class="intro">
    <p class="tag">
      Aktualności · {page > 1 ? `strona ${String(page)} z ${String(current.pages)}` : "ZSM3"}
    </p>
    <h1>
      <span class="rise">
        <span>{heading}</span>
      </span>
    </h1>
  </header>
  <div class="filters">
    <nav aria-label="Kategorie">
      <p class="tag">Kategoria</p>
      <ul>
        <li>
          <a href="/aktualnosci" aria-current={unfiltered ? "page" : undefined}>
            Wszystkie
          </a>
        </li>
        {listing.categories.map((entry) => (
          <li>
            <a
              href={categoryHref(entry)}
              aria-current={entry.slug === category ? "page" : undefined}
            >
              {entry.name}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <nav aria-label="Lata">
      <p class="tag">Rok</p>
      <ul>
        {listing.years.map((entry) => (
          <li>
            <a href={`/aktualnosci/${entry}`} aria-current={entry === year ? "page" : undefined}>
              {entry}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
  {lead !== undefined && <NewsCard item={lead} variant="lead" headingLevel={2} />}
  <ul class="grid">
    {rest.map((item) => (
      <li>
        <NewsCard item={item} headingLevel={2} />
      </li>
    ))}
  </ul>
  <Pagination base={base} page={current.page} pages={current.pages} />
</div>

<style>
  .listing {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
    padding-block: var(--space-7);
  }

  .intro {
    display: grid;
    gap: var(--space-4);
  }

  .tag {
    color: var(--ink-2);
  }

  h1 {
    font-size: var(--step-title);
    font-stretch: var(--stretch-wide);
    hyphens: auto;
  }

  .filters {
    display: grid;
    gap: var(--space-4);
  }

  .filters nav {
    display: grid;
    gap: var(--space-2);
  }

  .filters ul,
  .grid {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .filters ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .filters a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target);
    padding: var(--space-2) var(--space-4);
    border: var(--hairline) solid var(--line);
    border-radius: var(--radius);
    color: var(--ink);
    font-weight: 700;
    text-decoration: none;
  }

  .filters a:hover {
    border-color: var(--ink);
  }

  .filters a[aria-current="page"] {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--bg);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: var(--space-6) var(--space-5);
  }
</style>
