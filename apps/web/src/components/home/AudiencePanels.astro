---
import { audiencePanels } from "../../data/home.ts";
import { partners as loadPartners } from "../../server/datasets.ts";
import Icon from "../Icon.astro";

const partners = await loadPartners();
---

<section class="audiences" aria-label="Na skróty dla kandydatów, uczniów i rodziców">
  {audiencePanels.map((panel) => (
    <div class="panel">
      <h2>{panel.title}</h2>
      <ul>
        {panel.links.map((link) => (
          <li>
            <a href={link.href} rel={link.external === true ? "noopener" : undefined}>
              {link.label}
              {link.external === true && (
                <>
                  <Icon name="external" />
                  <span class="visually-hidden">(otwiera serwis zewnętrzny)</span>
                </>
              )}
            </a>
          </li>
        ))}
      </ul>
    </div>
  ))}
</section>

<section class="partners" aria-labelledby="partnerzy">
  <h2 id="partnerzy" class="tag">
    Partnerzy i projekty
  </h2>
  <ul>
    {partners.map((partner) => (
      <li>
        {partner.href === undefined ? (
          <span class="name">{partner.name}</span>
        ) : (
          <a class="name" href={partner.href}>
            {partner.name}
          </a>
        )}
        <span class="role">{partner.role}</span>
      </li>
    ))}
  </ul>
</section>

<style>
  .audiences {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: var(--space-4);
  }

  .panel {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    padding: var(--space-5);
    border-radius: var(--radius);
    background: var(--gray);
  }

  .panel h2 {
    font-size: var(--step-2);
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .panel a {
    display: flex;
    gap: var(--space-2);
    align-items: center;
    min-height: var(--target);
    border-bottom: var(--hairline) solid var(--line);
    color: var(--ink);
    font-weight: 700;
    text-decoration: none;
  }

  .panel a:hover {
    color: var(--link);
  }

  .partners {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    padding-block: var(--space-5);
    border-block: var(--hairline) solid var(--line);
  }

  .partners .tag {
    color: var(--ink-2);
    font-family: var(--font-mono);
    font-size: var(--step-n1);
    font-weight: 400;
    letter-spacing: 0.04em;
  }

  .partners ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-5);
  }

  .partners li {
    display: grid;
    gap: var(--space-1);
  }

  .partners .name {
    overflow-wrap: anywhere;
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-stretch: var(--stretch-display);
    font-weight: 800;
  }

  .role {
    overflow-wrap: anywhere;
    color: var(--ink-2);
  }
</style>
