---
import ProfessionIndexRow from "./ProfessionIndexRow.astro";
import SectionHead from "./SectionHead.astro";
import { fieldGroups } from "../../lib/professions.ts";
import { programmeData } from "../../server/datasets.ts";

const { professions } = await programmeData();
const groups = fieldGroups(professions);
---

<section class="finder" aria-labelledby="zawody">
  <SectionHead
    id="zawody"
    kicker="Dla kandydatów"
    title="Wybierz zawód"
    link={{ label: "Wszystkie zawody", href: "/kandydaci/zawody" }}
  />
  <div class="index">
    {groups.map((group) => (
      <section class="group" aria-labelledby={`branza-${group.field}`}>
        <h3 id={`branza-${group.field}`}>{group.label}</h3>
        <ul>
          {group.professions.map((profession) => (
            <ProfessionIndexRow profession={profession} />
          ))}
        </ul>
      </section>
    ))}
  </div>
</section>

<style>
  .finder {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
    min-width: 0;
  }

  .index {
    container: finder / inline-size;
    border-top: var(--rule) solid var(--section-rule);
  }

  .group {
    display: grid;
    gap: var(--space-2) var(--space-5);
    padding-block: var(--space-4);
    border-bottom: var(--hairline) solid var(--line);
  }

  h3 {
    color: var(--link);
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-stretch: var(--stretch-display);
    font-weight: 800;
    line-height: var(--leading-tight);
    overflow-wrap: break-word;
  }

  ul {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @container finder (width >= 48rem) {
    .group {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      align-items: start;
      padding-block: var(--space-5);
    }

    h3 {
      padding-block-start: var(--space-3);
    }
  }
</style>
