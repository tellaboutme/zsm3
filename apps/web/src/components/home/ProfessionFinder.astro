---
import ProfessionIndexRow from "./ProfessionIndexRow.astro";
import SectionHead from "./SectionHead.astro";
import { fieldGroups } from "../../lib/professions.ts";
import { programmeData } from "../../server/datasets.ts";

const { professions } = await programmeData();
const groups = fieldGroups(professions);
---

<section class="finder" aria-labelledby="zawody">
  <SectionHead
    id="zawody"
    kicker="Dla kandydatów"
    title="Wybierz zawód"
    link={{ label: "Wszystkie zawody", href: "/kandydaci/zawody" }}
  />
  <div class="index">
    {groups.map((group) => (
      <details name="branza">
        <summary>
          <span class="head">
            <span class="field">{group.label}</span>
            <span class="families" aria-hidden="true">
              {group.families.join(" ")}
            </span>
          </span>
          <span class="count">
            <span class="visually-hidden">, zawody: {group.professions.length}</span>
            <span aria-hidden="true">{String(group.professions.length).padStart(2, "0")}</span>
          </span>
          <span class="sign" aria-hidden="true"></span>
        </summary>
        <ul class="list">
          {group.professions.map((profession) => (
            <ProfessionIndexRow profession={profession} />
          ))}
        </ul>
      </details>
    ))}
  </div>
</section>

<style>
  .finder {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
    min-width: 0;
  }

  .index {
    container-type: inline-size;
    border-top: var(--rule) solid var(--section-rule);
  }

  details {
    border-bottom: var(--hairline) solid var(--line);
    interpolate-size: allow-keywords;
  }

  summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    gap: var(--space-4);
    align-items: center;
    min-height: var(--target);
    padding: var(--space-4) var(--space-3);
    list-style: none;
    cursor: pointer;
    transition:
      background-color var(--duration-2) var(--ease),
      color var(--duration-2) var(--ease);
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover,
  summary:focus-visible,
  details[open] > summary {
    background: var(--blue);
    color: var(--blue-ink);
  }

  .head {
    display: grid;
    gap: var(--space-1);
    min-width: 0;
  }

  .field {
    font-family: var(--font-display);
    font-size: min(var(--step-3), 6.2cqi);
    font-stretch: var(--stretch-wide);
    font-weight: 800;
    line-height: var(--leading-tight);
    text-transform: uppercase;
    overflow-wrap: break-word;
  }

  .families,
  .count {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  .families {
    color: var(--ink-2);
    font-size: var(--step-n1);
  }

  .count {
    font-size: min(var(--step-3), 7cqi);
    line-height: var(--leading-tight);
  }

  summary:hover .families,
  summary:focus-visible .families,
  details[open] .families {
    color: var(--blue-dim);
  }

  .sign {
    position: relative;
    inline-size: var(--space-5);
    block-size: var(--space-5);
  }

  .sign::before,
  .sign::after {
    position: absolute;
    inset: calc(50% - var(--hairline)) 0 auto;
    block-size: var(--ring);
    background: currentcolor;
    content: "";
    transition: transform var(--duration-2) var(--ease);
  }

  .sign::after {
    transform: rotate(90deg);
  }

  details[open] .sign::after {
    transform: rotate(0deg);
  }

  details::details-content {
    block-size: 0;
    overflow: clip;
    transition:
      block-size var(--duration-2) var(--ease),
      content-visibility var(--duration-2) allow-discrete;
  }

  details[open]::details-content {
    block-size: auto;
  }

  .list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    margin: 0;
    padding: 0 0 var(--space-5);
    background: var(--blue);
    color: var(--blue-ink);
    list-style: none;
  }
</style>
