---
import SectionHead from "./SectionHead.astro";
import { officialSites, socialProfiles } from "../../data/site.ts";
import { isVisibleHref } from "../../lib/navigation.ts";
import { partners as loadPartners } from "../../server/datasets.ts";
import { pagesReader } from "../../server/pages.ts";
import Icon from "../Icon.astro";

const [partners, paths] = await Promise.all([loadPartners(), pagesReader().publishedPaths()]);
const publishedPaths = new Set(paths);
const groups = [
  { id: "profile", title: "Profile szkoły", items: socialProfiles },
  { id: "serwisy", title: "Serwisy urzędowe", items: officialSites },
];
---

<section class="social" aria-labelledby="w-sieci">
  <SectionHead id="w-sieci" title="Partnerzy i szkoła w sieci" />
  <div class="groups">
    <div class="group">
      <h3 id="partnerzy">Partnerzy i projekty</h3>
      <ul aria-labelledby="partnerzy">
        {partners.map((partner) => (
          <li class="row">
            {partner.href !== undefined && isVisibleHref(partner.href, publishedPaths) ? (
              <a class="name" href={partner.href}>
                {partner.name}
              </a>
            ) : (
              <span class="name">{partner.name}</span>
            )}
            <span class="note">{partner.role}</span>
          </li>
        ))}
      </ul>
    </div>
    {groups.map((group) => (
      <div class="group">
        <h3 id={group.id}>{group.title}</h3>
        <ul aria-labelledby={group.id}>
          {group.items.map((item) => (
            <li>
              <a class="row link" href={item.href} rel="noopener">
                <span class="name">{item.name}</span>
                <span class="note">{item.handle}</span>
                <span class="go" aria-hidden="true">
                  <Icon name="external" />
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>

<style>
  .social {
    display: grid;
    gap: var(--space-5);
  }

  .groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-5);
  }

  .group {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    min-width: 0;
  }

  h3 {
    color: var(--ink-2);
    font-family: var(--font-body);
    font-size: var(--step-n1);
    font-weight: 600;
    letter-spacing: 0;
  }

  ul {
    margin: 0;
    padding: 0;
    border-top: var(--hairline) solid var(--line);
    list-style: none;
  }

  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0 var(--space-4);
    align-items: center;
    min-height: var(--target);
    padding-block: var(--space-2);
    border-bottom: var(--hairline) solid var(--line);
  }

  .link {
    color: var(--ink);
    text-decoration: none;
  }

  .name {
    min-width: 0;
    overflow-wrap: anywhere;
    font-weight: 600;
  }

  .note {
    grid-column: 1;
    min-width: 0;
    overflow-wrap: anywhere;
    color: var(--ink-2);
    font-size: var(--step-n1);
  }

  .go {
    grid-row: 1 / span 2;
    grid-column: 2;
    display: inline-flex;
    color: var(--ink-2);
  }

  .link:hover .name,
  a.name:hover {
    color: var(--link);
  }
</style>
