---
import SectionHead from "./SectionHead.astro";
import { officialSites, socialProfiles } from "../../data/site.ts";
import Icon from "../Icon.astro";

const groups = [
  { id: "profile", title: "Profile szkoły", items: socialProfiles },
  { id: "serwisy", title: "Serwisy urzędowe", items: officialSites },
];
---

<section class="social" aria-labelledby="w-sieci">
  <SectionHead id="w-sieci" kicker="Szkoła w sieci" title="Gdzie jeszcze nas znajdziesz" />
  <div class="groups">
    {groups.map((group) => (
      <div class="group">
        <h3 id={group.id}>{group.title}</h3>
        <ul aria-labelledby={group.id}>
          {group.items.map((item) => (
            <li class="reveal">
              <a href={item.href} rel="noopener">
                <span class="name">{item.name}</span>
                <span class="handle">{item.handle}</span>
                <span class="go" aria-hidden="true">
                  <Icon name="external" />
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>

<style>
  .social {
    display: grid;
    gap: var(--space-5);
  }

  .groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-5);
  }

  .group {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    min-width: 0;
  }

  h3 {
    color: var(--ink-2);
    font-family: var(--font-mono);
    font-size: var(--step-n1);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  ul {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    border-block-start: var(--hairline) solid var(--line);
    list-style: none;
  }

  a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-1) var(--space-4);
    align-items: center;
    min-height: var(--target);
    padding: var(--space-3) var(--space-2);
    border-block-end: var(--hairline) solid var(--line);
    color: var(--ink);
    text-decoration: none;
    transition:
      background var(--duration-1) var(--ease),
      color var(--duration-1) var(--ease);
  }

  .name {
    min-width: 0;
    overflow-wrap: anywhere;
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-stretch: var(--stretch-display);
    font-weight: 800;
  }

  .handle {
    grid-column: 1;
    min-width: 0;
    overflow-wrap: anywhere;
    color: var(--ink-2);
    font-family: var(--font-mono);
    font-size: var(--step-n1);
  }

  .go {
    grid-row: 1 / span 2;
    grid-column: 2;
    display: inline-flex;
    color: var(--ink-2);
  }

  a:hover,
  a:focus-visible {
    background: var(--blue);
    color: var(--blue-ink);
  }

  a:hover .handle,
  a:focus-visible .handle,
  a:hover .go,
  a:focus-visible .go {
    color: var(--blue-dim);
  }
</style>
