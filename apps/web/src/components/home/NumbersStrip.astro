---
import { professions } from "../../data/professions.ts";
import { fields } from "../../lib/professions.ts";
import FactStrip from "../FactStrip.astro";

const numbers = [
  { value: String(professions.length), label: "zawodów w technikum i szkole branżowej" },
  { value: String(fields.length), label: "branż: od informatyki po lotnictwo" },
  { value: "5 lat", label: "nauki w technikum, z maturą i tytułem technika" },
  { value: "Erasmus+", label: "wyjazdy i praktyki zagraniczne od 2014 roku" },
];
---

<FactStrip label="Szkoła w liczbach" facts={numbers} />
