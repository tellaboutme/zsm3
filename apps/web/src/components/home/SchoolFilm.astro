---
import type { PublicFeaturedPhoto } from "@zsm3/contracts/featured";

import SectionHead from "./SectionHead.astro";
import { externalServices, schoolFilm, socialProfiles } from "../../data/site.ts";
import { featuredImage } from "../../lib/featured.ts";
import Icon from "../Icon.astro";

interface Props {
  readonly photo: PublicFeaturedPhoto | undefined;
}

const { photo } = Astro.props;
const image = photo === undefined ? undefined : featuredImage(photo);
const tiles = [
  ...socialProfiles,
  { name: "Wirtualny spacer", handle: "szkoła w 360°", href: externalServices.virtualTour },
];
---

<section class="film" aria-labelledby="w-sieci">
  <SectionHead id="w-sieci" title="Szkoła w sieci" />
  <div class="layout">
    <a class="poster" href={schoolFilm.href} rel="noopener" target="_blank">
      <span class="frame" data-photo={image === undefined ? "off" : "on"}>
        {image !== undefined && (
          <img
            src={image.src}
            srcset={image.srcset}
            sizes="(width >= 64rem) 40rem, 100vw"
            width={image.width}
            height={image.height}
            alt=""
            loading="lazy"
            decoding="async"
          />
        )}
        <span class="play" aria-hidden="true"></span>
        <time class="duration" datetime={schoolFilm.isoDuration}>
          {schoolFilm.duration}
        </time>
      </span>
      <span class="caption">
        <span class="name">{schoolFilm.title}</span>
        <span class="where">
          Film na YouTube <span class="visually-hidden">(otwiera nową stronę)</span>
        </span>
      </span>
    </a>
    <ul class="tiles">
      {tiles.map((tile) => (
        <li>
          <a class="tile nudge" href={tile.href} rel="noopener">
            <span class="tile-name">{tile.name}</span>
            <span class="tile-handle">{tile.handle}</span>
            <span class="go" aria-hidden="true">
              <Icon name="external" />
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .film {
    display: grid;
    gap: var(--space-5);
  }

  .layout {
    display: grid;
    gap: var(--space-5);
  }

  .poster {
    display: grid;
    gap: var(--space-2);
    color: var(--ink);
    text-decoration: none;
  }

  .frame {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 9;
    max-width: 100%;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--blue-2);
  }

  img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale var(--duration-3) var(--ease);
  }

  .poster:hover img {
    scale: 1.04;
  }

  .play {
    position: relative;
    display: grid;
    place-items: center;
    inline-size: 4.5rem;
    block-size: 4.5rem;
    border-radius: var(--radius-round);
    background: var(--orange-surface);
    box-shadow: var(--shadow-float);
  }

  .play::before {
    margin-inline-start: var(--space-1);
    border-block: 0.8rem solid transparent;
    border-inline-start: 1.2rem solid var(--on-photo);
    content: "";
  }

  .duration {
    position: absolute;
    right: var(--space-3);
    bottom: var(--space-3);
    padding: 0 var(--space-2);
    border-radius: var(--radius);
    background: var(--scrim);
    color: var(--on-photo);
    font-family: var(--font-mono);
    font-size: var(--step-n1);
  }

  .caption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-1) var(--space-3);
  }

  .name {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: var(--weight-heading);
  }

  .where {
    color: var(--ink-2);
    font-size: var(--step-n1);
  }

  .poster:hover .name {
    color: var(--link);
    text-decoration: underline;
  }

  .tiles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-content: start;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tiles > :last-child:nth-child(odd) {
    grid-column: 1 / -1;
  }

  .tile {
    position: relative;
    display: grid;
    gap: var(--space-1);
    height: 100%;
    padding: var(--space-3) var(--space-6) var(--space-3) var(--space-4);
    border: var(--hairline) solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
    transition: border-color var(--duration-2) var(--ease);
  }

  .tile:hover {
    border-color: var(--blue);
  }

  .tile-name {
    font-weight: 700;
  }

  .tile-handle {
    color: var(--ink-2);
    font-family: var(--font-mono);
    font-size: var(--step-n1);
    overflow-wrap: anywhere;
  }

  .go {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    color: var(--ink-2);
  }

  @media (width >= 64rem) {
    .layout {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
      align-items: start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    img {
      transition: none;
    }
  }
</style>
