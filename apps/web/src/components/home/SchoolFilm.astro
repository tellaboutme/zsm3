---
import type { PublicFeaturedPhoto } from "@zsm3/contracts/featured";

import FilmPoster from "./FilmPoster.astro";
import SectionHead from "./SectionHead.astro";
import { externalServices, socialProfiles } from "../../data/site.ts";
import Icon from "../Icon.astro";

interface Props {
  readonly photo: PublicFeaturedPhoto | undefined;
}

const { photo } = Astro.props;
const tiles = [
  ...socialProfiles,
  { name: "Wirtualny spacer", handle: "szkoła w 360°", href: externalServices.virtualTour },
];
---

<section class="film" aria-labelledby="w-sieci">
  <SectionHead id="w-sieci" title="Szkoła w sieci" />
  <div class="layout">
    <FilmPoster photo={photo} />
    <ul class="tiles">
      {tiles.map((tile) => (
        <li>
          <a class="tile nudge" href={tile.href} rel="noopener">
            <span class="tile-name">{tile.name}</span>
            <span class="tile-handle">{tile.handle}</span>
            <span class="go" aria-hidden="true">
              <Icon name="external" />
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .film,
  .layout {
    display: grid;
    gap: var(--space-5);
  }

  .tiles {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: start;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tile {
    position: relative;
    display: grid;
    gap: var(--space-1);
    height: 100%;
    padding: var(--space-3) var(--space-6) var(--space-3) var(--space-4);
    border: var(--hairline) solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
    transition: border-color var(--duration-2) var(--ease);
  }

  .tile:hover {
    border-color: var(--blue);
  }

  .tile-name {
    font-weight: 700;
  }

  .tile-handle {
    color: var(--ink-2);
    font-family: var(--font-mono);
    font-size: var(--step-n1);
    overflow-wrap: anywhere;
  }

  .go {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    color: var(--ink-2);
  }

  @media (width >= 30rem) {
    .tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .tiles > :last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }

  @media (width >= 64rem) {
    .layout {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
      align-items: start;
    }
  }
</style>
