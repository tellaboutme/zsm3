---
import type { PublicFeaturedPhoto } from "@zsm3/contracts/featured";

import EntryLinks from "./EntryLinks.astro";
import HomeHead from "./HomeHead.astro";
import { audiencePanels } from "../../data/home.ts";
import { isoDay, longDate, nextEvent } from "../../lib/calendar.ts";
import { visibleGroups } from "../../lib/navigation.ts";
import { fields } from "../../lib/professions.ts";
import { programmeData } from "../../server/datasets.ts";
import { pagesReader } from "../../server/pages.ts";
import LiveStatus from "../LiveStatus.astro";

interface Props {
  readonly photo: PublicFeaturedPhoto | undefined;
}

const { photo } = Astro.props;

const [{ professions }, paths] = await Promise.all([
  programmeData(),
  pagesReader().publishedPaths(),
]);
const [candidate, student, parent] = visibleGroups(audiencePanels, new Set(paths));
const meeting = nextEvent(Astro.locals.events ?? [], isoDay(new Date()), "Rodzice");
---

<section class="hero" aria-labelledby="tytul">
  <HomeHead photo={photo} />
  <h2 class="visually-hidden">Na skróty</h2>
  <div class="entries">
    <div class="entry">
      <h3>{candidate?.title ?? "Dla kandydata"}</h3>
      <a class="card nudge tap-target" href="/kandydaci/zawody">
        <span class="top">
          <span class="label">Kształcenie zawodowe</span>
          <span class="go">
            Wszystkie zawody <span aria-hidden="true">→</span>
          </span>
        </span>
        <span class="title">{professions.length} zawodów</span>
        <span class="text">w {fields.length} branżach, w technikum i szkole branżowej</span>
      </a>
      {candidate !== undefined && <EntryLinks links={candidate.links} />}
    </div>
    <div class="entry">
      <h3>{student?.title ?? "Dla ucznia"}</h3>
      <LiveStatus />
      {student !== undefined && <EntryLinks links={student.links} />}
    </div>
    <div class="entry">
      <h3>{parent?.title ?? "Dla rodzica"}</h3>
      <a class="card nudge tap-target" href="/szkola/terminarz">
        <span class="top">
          <span class="label">Najbliższe wydarzenie dla rodziców</span>
          <span class="go">
            Terminarz <span aria-hidden="true">→</span>
          </span>
        </span>
        {meeting === undefined ? (
          <span class="title">Terminy zebrań w terminarzu</span>
        ) : (
          <>
            <span class="title">{meeting.title}</span>
            <time class="text date" datetime={meeting.date}>
              {longDate(meeting.date)}
            </time>
          </>
        )}
      </a>
      {parent !== undefined && <EntryLinks links={parent.links} />}
    </div>
  </div>
</section>

<style>
  .hero {
    display: grid;
    gap: var(--space-6);
    padding-top: var(--space-6);
  }

  .entries {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6) var(--space-5);
  }

  .entry {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: var(--space-3);
  }

  .card {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    padding: var(--space-4) var(--space-5) var(--space-5);
    border: var(--hairline) solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
    transition: border-color var(--duration-2) var(--ease);
  }

  .card:hover {
    border-color: var(--blue);
  }

  .top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-1) var(--space-3);
  }

  .label,
  .text {
    color: var(--ink-2);
  }

  .label {
    font-size: var(--step-n1);
  }

  .go {
    color: var(--link);
    font-size: var(--step-n1);
    font-weight: 700;
    text-decoration: underline;
  }

  .title {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: var(--weight-heading);
    line-height: var(--leading-snug);
  }

  @media (width >= 64rem) {
    .entries {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .entry {
      grid-row: span 3;
      grid-template-rows: subgrid;
    }
  }
</style>
