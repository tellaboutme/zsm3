---
import { pathLabel, type Profession } from "../../lib/professions.ts";

interface Props {
  profession: Profession;
}

const { profession } = Astro.props;
---

<li>
  <a href={`/kandydaci/zawody/${profession.slug}`}>
    <span class="name">{profession.name}</span>
    <span class="codes">
      {profession.qualifications.map((qualification) => (
        <abbr class="code" title={qualification.name}>
          {qualification.code}
        </abbr>
      ))}
    </span>
    <span class="paths">
      {profession.paths.map((path) => (
        <span>{pathLabel(path)}</span>
      ))}
    </span>
  </a>
</li>

<style>
  a {
    display: grid;
    gap: var(--space-2);
    block-size: 100%;
    padding: var(--space-4) var(--space-3);
    border-top: var(--hairline) solid var(--blue-dim);
    color: inherit;
    text-decoration: none;
    transition: background-color var(--duration-1) var(--ease);
  }

  a:hover {
    background: var(--blue-2);
  }

  a:focus-visible {
    outline-color: var(--blue-ink);
    outline-offset: calc(-1 * var(--rule));
  }

  .name {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-stretch: var(--stretch-display);
    font-weight: 800;
    line-height: var(--leading-snug);
  }

  .name::after {
    content: "\a0→" / "";
  }

  .codes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .code,
  .paths {
    font-family: var(--font-mono);
    font-size: var(--step-n1);
    font-variant-numeric: tabular-nums;
  }

  .code {
    padding: var(--space-1) var(--space-2);
    border: var(--hairline) solid currentcolor;
    border-radius: var(--radius);
    text-decoration: none;
  }

  .paths {
    display: grid;
    color: var(--blue-dim);
  }
</style>
