---
import SectionHead from "./SectionHead.astro";
import type { NewsItem } from "../../lib/news.ts";
import NewsCard from "../news/NewsCard.astro";

interface Props {
  items: readonly NewsItem[];
}

const { items } = Astro.props;
const [first, ...rest] = items;
---

<section class="news" aria-labelledby="aktualnosci">
  <SectionHead
    id="aktualnosci"
    title="Co się dzieje w szkole"
    link={{ label: "Wszystkie aktualności", href: "/aktualnosci" }}
  />
  <ul class="cards">
    {first !== undefined && (
      <li class="first reveal">
        <NewsCard item={first} variant="lead" />
      </li>
    )}
    {rest.map((item) => (
      <li class="reveal">
        <NewsCard item={item} />
      </li>
    ))}
  </ul>
</section>

<style>
  .news {
    display: grid;
    gap: var(--space-5);
  }

  .cards {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (width >= 40rem) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .first {
      grid-column: 1 / -1;
    }
  }

  @media (width >= 64rem) {
    .cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
