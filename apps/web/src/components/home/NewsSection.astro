---
import SectionHead from "./SectionHead.astro";
import type { NewsItem } from "../../lib/news.ts";
import NewsCard from "../news/NewsCard.astro";

interface Props {
  items: readonly NewsItem[];
}

const { items } = Astro.props;
---

<section class="news" aria-labelledby="aktualnosci">
  <SectionHead
    id="aktualnosci"
    kicker="Aktualności"
    title="Co się dzieje w szkole"
    link={{ label: "Wszystkie aktualności", href: "/aktualnosci" }}
  />
  <ul class="cards">
    {items.map((item) => (
      <li class="reveal">
        <NewsCard item={item} />
      </li>
    ))}
  </ul>
</section>

<style>
  .news {
    display: grid;
    gap: var(--space-5);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
