---
import PageHead from "../PageHead.astro";
import ContentBlocks from "./ContentBlocks.astro";
import InPageNav from "./InPageNav.astro";
import SiblingNav from "./SiblingNav.astro";
import { publicFallbackNavigation } from "../../data/navigation.ts";
import Base from "../../layouts/Base.astro";
import {
  needsInPageNav,
  sectionTitleFor,
  siblingLinks,
  type ContentPage,
} from "../../lib/content.ts";

const { sections } = Astro.locals.navigation ?? publicFallbackNavigation;

interface Props {
  page: ContentPage;
}

const { page } = Astro.props;
const parent = sectionTitleFor(sections, page.path);
const withNav = needsInPageNav(page);
const cardLayout = page.path === "/szkola/biblioteka" || page.path === "/uczniowie/kola-i-kluby";
---

<Base
  title={`${page.title} — ZSM3`}
  description={page.intro}
  breadcrumbs={[...(parent === undefined ? [] : [parent]), { label: page.title }]}
>
  <div class:list={["content-page", { "card-layout": cardLayout }]}>
    <PageHead title={page.title} lead={page.intro}>
      {page.kicker !== "" && <Fragment slot="meta">{page.kicker}</Fragment>}
    </PageHead>
    <div class:list={["body", { "with-nav": withNav }]}>
      {withNav && (
        <div class="aside">
          <InPageNav sections={page.sections} />
        </div>
      )}
      <div class="sections">
        {page.sections.map((section) => (
          <section class="section" id={section.id} aria-labelledby={`${section.id}-tytul`}>
            <h2 id={`${section.id}-tytul`}>{section.title}</h2>
            <ContentBlocks blocks={section.blocks} />
          </section>
        ))}
      </div>
    </div>
    <SiblingNav title="Zobacz też" links={siblingLinks(sections, page.path)} />
  </div>
</Base>

<style>
  .content-page,
  .body,
  .sections {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-7);
  }

  .content-page {
    padding-block: var(--space-7);
  }

  .section {
    display: grid;
    gap: var(--space-5);
    scroll-margin-top: var(--header-height);
  }

  .section h2 {
    font-size: var(--step-3);
  }

  .card-layout .sections {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .card-layout .section {
    min-width: 0;
    align-content: start;
    gap: var(--space-4);
    padding: var(--space-5);
    border: var(--hairline) solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .card-layout .section h2 {
    font-size: var(--step-2);
  }

  .card-layout .section:first-of-type,
  .card-layout .section:last-of-type {
    grid-column: 1 / -1;
  }

  @media (width <= 48rem) {
    .card-layout .sections {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (width >= 64rem) {
    .with-nav {
      grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
      align-items: start;
    }

    .with-nav .aside {
      position: sticky;
      top: calc(var(--header-height-compact) + var(--space-5));
      grid-row: 1;
      grid-column: 2;
    }

    .with-nav .sections {
      grid-row: 1;
      grid-column: 1;
    }
  }
</style>
