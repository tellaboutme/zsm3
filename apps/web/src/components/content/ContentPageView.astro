---
import ContentBlocks from "./ContentBlocks.astro";
import InPageNav from "./InPageNav.astro";
import SiblingNav from "./SiblingNav.astro";
import { sections } from "../../data/navigation.ts";
import Base from "../../layouts/Base.astro";
import {
  needsInPageNav,
  sectionTitleFor,
  siblingLinks,
  type ContentPage,
} from "../../lib/content.ts";

interface Props {
  page: ContentPage;
}

const { page } = Astro.props;
const parent = sectionTitleFor(sections, page.path);
const cardLayout = page.path === "/szkola/biblioteka" || page.path === "/uczniowie/kola-i-kluby";
---

<Base
  title={`${page.title} — ZSM3`}
  description={page.intro}
  breadcrumbs={[...(parent === undefined ? [] : [parent]), { label: page.title }]}
>
  <div class:list={["content-page", { "card-layout": cardLayout }]}>
    <header class="intro">
      <p class="tag">{page.kicker}</p>
      <h1>
        <span class="rise">
          <span>{page.title}</span>
        </span>
      </h1>
      <p class="lead">{page.intro}</p>
    </header>
    {needsInPageNav(page) && (
      <div class="page-nav">
        <InPageNav sections={page.sections} />
      </div>
    )}
    {page.sections.map((section) => (
      <section class="section" id={section.id} aria-labelledby={`${section.id}-tytul`}>
        <h2 id={`${section.id}-tytul`}>{section.title}</h2>
        <ContentBlocks blocks={section.blocks} />
      </section>
    ))}
    <div class="page-nav">
      <SiblingNav title="Zobacz też" links={siblingLinks(sections, page.path)} />
    </div>
  </div>
</Base>

<style>
  .content-page {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-7);
    padding-block: var(--space-7) var(--space-8);
  }

  .intro {
    display: grid;
    gap: var(--space-4);
  }

  .tag {
    color: var(--ink-2);
  }

  h1 {
    font-size: var(--step-title);
    font-stretch: var(--stretch-wide);
    hyphens: auto;
  }

  .lead {
    max-width: var(--measure);
    font-size: var(--step-1);
    line-height: var(--leading-snug);
  }

  .section {
    display: grid;
    gap: var(--space-5);
    scroll-margin-top: var(--header-height);
  }

  .section h2 {
    font-size: var(--step-3);
  }

  .card-layout {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .card-layout .intro,
  .card-layout .page-nav {
    grid-column: 1 / -1;
  }

  .card-layout .section {
    min-width: 0;
    align-content: start;
    gap: var(--space-4);
    padding: var(--space-5);
    border: var(--hairline) solid var(--line);
    border-top: var(--rule) solid var(--blue);
    background: var(--gray);
  }

  .card-layout .section h2 {
    font-size: var(--step-2);
  }

  .card-layout .section:first-of-type,
  .card-layout .section:last-of-type {
    grid-column: 1 / -1;
  }

  .card-layout .section:first-of-type {
    background: var(--bg);
  }

  @media (width <= 48rem) {
    .card-layout {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
