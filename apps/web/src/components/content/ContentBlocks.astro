---
import Callout from "./Callout.astro";
import FileList from "./FileList.astro";
import RichText from "./RichText.astro";
import Timeline from "./Timeline.astro";
import type { ContentBlock } from "../../lib/content.ts";
import FactStrip from "../FactStrip.astro";

interface Props {
  blocks: readonly ContentBlock[];
  idPrefix?: string | undefined;
}

const { blocks, idPrefix = "blok" } = Astro.props;
---

{blocks.map((block, index) => {
  switch (block.type) {
    case "rich-text":
      return (
        <RichText document={block.document} idPrefix={`${idPrefix}-${String(index + 1)}-tabela`} />
      );
    case "facts":
      return <FactStrip label={block.label} facts={block.facts} />;
    case "timeline":
      return <Timeline items={block.items} />;
    case "callout":
      return <Callout title={block.title} text={block.text} link={block.link} />;
    case "files":
      return <FileList block={block} />;
  }
})}
