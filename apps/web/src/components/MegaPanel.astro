---
import Icon from "./Icon.astro";
import MenuFeature from "./MenuFeature.astro";
import type { NavSection } from "../lib/navigation.ts";

interface Props {
  section: NavSection;
}

const { section } = Astro.props;
---

<div class="panel" id={`menu-${section.id}`} hidden data-menu-panel>
  <div class="page inner">
    <p class="head">
      <a class="overview nudge" href={section.href}>
        {section.label}: przegląd <span aria-hidden="true">→</span>
      </a>
    </p>
    <div class="groups">
      {section.groups.map((group) => (
        <section>
          <h2 class="tag">{group.title}</h2>
          <ul>
            {group.links.map((link) => (
              <li>
                <a
                  class="link"
                  href={link.href}
                  rel={link.external === true ? "external" : undefined}
                >
                  {link.label}
                  {link.external === true && (
                    <>
                      <Icon name="external" />
                      <span class="visually-hidden">(strona zewnętrzna)</span>
                    </>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
    {section.featured !== undefined && (
      <div class="featured">
        <MenuFeature feature={section.featured} />
      </div>
    )}
  </div>
</div>

<style>
  .panel {
    position: absolute;
    top: 100%;
    right: 0;
    left: 0;
    z-index: var(--z-menu);
    padding-block: var(--space-6) var(--space-7);
    border-bottom: var(--hairline) solid var(--line);
    background: var(--bg);
    box-shadow: var(--shadow-float);
  }

  .inner {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(16rem, 1fr);
    gap: var(--space-5) var(--space-7);
  }

  .head {
    grid-column: 1 / -1;
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-stretch: var(--stretch-display);
    font-weight: 800;
  }

  .overview {
    color: var(--ink);
    text-decoration: none;
  }

  .groups {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
  }

  h2 {
    margin-bottom: var(--space-3);
    color: var(--ink-2);
    font-family: var(--font-mono);
    font-size: var(--step-n1);
    font-stretch: 100%;
    font-weight: 500;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .link {
    display: flex;
    gap: var(--space-2);
    align-items: center;
    min-height: var(--target);
    padding-block: var(--space-1);
    border-bottom: var(--hairline) solid var(--line);
    color: var(--ink);
    font-weight: 600;
    text-decoration: none;
  }

  .link:hover {
    color: var(--link);
  }
</style>
