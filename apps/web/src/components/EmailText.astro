---
import { emailSegments } from "../lib/email-breaks.ts";

interface Props {
  email: string;
}

const { email } = Astro.props;
---

<span class="email">
  {emailSegments(email).flatMap((part, index) => (index === 0 ? [part] : [<wbr />, part]))}
</span>

<style>
  .email {
    overflow-wrap: break-word;
  }
</style>
