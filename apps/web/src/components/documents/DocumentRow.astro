---
import { longDate } from "../../lib/calendar.ts";
import { fileSize, signerLabels, type SchoolDocument } from "../../lib/documents.ts";

interface Props {
  document: SchoolDocument;
}

const { document } = Astro.props;
---

<li class="row" data-signer={document.signer}>
  <span class="code">{document.code}</span>
  <div class="text">
    <h3>
      <a href={document.href}>{document.title}</a>
    </h3>
    <p class="description">{document.description}</p>
    <p class="who">{signerLabels[document.signer]}</p>
  </div>
  <p class="meta">
    PDF, {fileSize(document.bytes)}
    <br />
    <time datetime={document.updated}>{longDate(document.updated)}</time>
  </p>
</li>

<style>
  .row {
    position: relative;
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    gap: var(--space-2) var(--space-4);
    padding-block: var(--space-4);
    border-bottom: var(--hairline) solid var(--line);
  }

  .code {
    display: grid;
    place-items: center;
    align-self: start;
    min-height: var(--target);
    border-radius: var(--radius);
    background: var(--ink);
    color: var(--bg);
    font-family: var(--font-mono);
    font-weight: 600;
  }

  .text {
    display: grid;
    gap: var(--space-1);
  }

  h3 {
    font-size: var(--step-1);
    line-height: var(--leading-snug);
  }

  h3 a {
    color: var(--ink);
    text-decoration: none;
  }

  h3 a::after {
    position: absolute;
    inset: 0;
    content: "";
  }

  .row:hover h3 a {
    color: var(--link);
    text-decoration: underline;
  }

  .description,
  .meta {
    color: var(--ink-2);
  }

  .who {
    font-weight: 700;
  }

  .meta {
    grid-column: 2;
    font-family: var(--font-mono);
    font-size: var(--step-n1);
  }

  @media (width >= 56rem) {
    .row {
      grid-template-columns: 3.5rem minmax(0, 1fr) 11rem;
    }

    .meta {
      grid-column: 3;
      text-align: right;
    }
  }
</style>
