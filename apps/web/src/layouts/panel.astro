---
import "@fontsource-variable/source-sans-3/wght.css";
import sourceSans from "@fontsource-variable/source-sans-3/files/source-sans-3-latin-wght-normal.woff2?url";

import { bootScript } from "../lib/preferences.ts";

import "../styles/global.css";
import "../styles/panel.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <script is:inline set:html={bootScript} />
    <link rel="preload" href={sourceSans} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#panel-tresc">
      Przejdź do treści
    </a>
    <header class="panel-header">
      <a class="panel-home" href="/">
        Strona szkoły
      </a>
      <div class="panel-account">
        <p class="panel-user" data-panel="panel-user"></p>
        <a class="panel-logout" data-panel="panel-logout" href="/cdn-cgi/access/logout" hidden>
          Wyloguj
        </a>
      </div>
    </header>
    <main id="panel-tresc" class="page panel-main">
      <slot />
    </main>
  </body>
</html>
