---
import "@fontsource-variable/source-sans-3/wght.css";
import sourceSans from "@fontsource-variable/source-sans-3/files/source-sans-3-latin-wght-normal.woff2?url";

import { bootScript } from "../lib/preferences.ts";

import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <script is:inline set:html={bootScript} />
    <link rel="preload" href={sourceSans} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#panel-tresc">
      Przejdź do treści
    </a>
    <header class="panel-header">
      <a class="panel-home" href="/">
        Strona szkoły
      </a>
      <div class="panel-account">
        <p class="panel-user" data-panel="panel-user"></p>
        <a class="panel-logout" data-panel="panel-logout" href="/cdn-cgi/access/logout" hidden>
          Wyloguj
        </a>
      </div>
    </header>
    <main id="panel-tresc" class="page panel-main">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  .panel-header {
    display: flex;
    gap: var(--space-4);
    align-items: center;
    justify-content: space-between;
    width: min(100% - 2 * var(--space-5), var(--page-max));
    margin-inline: auto;
    padding-block: var(--space-3);
    border-block-end: var(--hairline) solid var(--line);
  }

  .panel-user {
    color: var(--ink-2);
    overflow-wrap: anywhere;
  }

  .panel-main {
    display: grid;
    gap: var(--space-5);
    padding-block: var(--space-6) var(--space-8);
  }

  .panel-page,
  .panel-columns {
    display: grid;
    gap: var(--space-5);
  }

  .panel-columns {
    grid-template-columns: repeat(auto-fit, minmax(min(20rem, 100%), 1fr));
    align-items: start;
  }

  .panel-page > h1 {
    font-size: var(--step-2);
  }

  .panel-gate {
    display: grid;
    gap: var(--space-3);
    max-width: var(--measure);
    padding: var(--space-5);
    border: var(--rule) solid var(--orange);
    border-radius: var(--radius);
    background: var(--gray);
  }

  .panel-note:empty {
    display: none;
  }

  .panel-row,
  .panel-actions {
    display: flex;
    gap: var(--space-3);
    align-items: end;
    flex-wrap: wrap;
  }

  .panel-item,
  .panel-block {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-3);
    border: var(--hairline) solid var(--line);
    border-radius: var(--radius);
    background: var(--gray);
  }

  .panel-meta {
    color: var(--ink-2);
    font-size: var(--step-n1);
    font-family: var(--font-mono);
    overflow-wrap: anywhere;
  }

  .panel-form fieldset,
  .panel-event {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-3);
    border: var(--hairline) solid var(--line);
    border-radius: var(--radius);
  }

  .panel-form legend,
  .panel-event legend {
    padding-inline: var(--space-2);
    color: var(--ink-2);
    font-size: var(--step-n1);
  }

  .panel-form label,
  .panel-event label,
  .panel-inline {
    display: grid;
    gap: var(--space-1);
  }

  .panel-form input:not([type="checkbox"]),
  .panel-form select,
  .panel-form textarea,
  .panel-event input:not([type="checkbox"]),
  .panel-event select {
    width: 100%;
    max-width: 100%;
    padding: var(--space-2) var(--space-3);
    border: var(--hairline) solid var(--line);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--ink);
  }

  .panel-form textarea {
    min-height: 6rem;
    resize: vertical;
  }

  .panel-actions > button,
  .panel-row > button,
  .panel-gate > button,
  .panel-open,
  .panel-move,
  .panel-remove,
  .panel-redirect-save,
  .panel-redirect-delete,
  .panel-remove-section,
  .panel-remove-event,
  .panel-pager > button {
    min-width: var(--target);
    min-height: var(--target);
    padding: var(--space-1) var(--space-3);
    border: var(--hairline) solid var(--line);
    border-radius: var(--radius);
    background: var(--gray);
    color: var(--ink);
  }

  .panel-actions > button.panel-save {
    padding: var(--space-2) var(--space-5);
    border: var(--hairline) solid var(--blue);
    background: var(--blue);
    color: var(--blue-ink);
    font-weight: 700;
  }

  .panel-actions > button:disabled {
    opacity: 0.55;
  }

  .panel-block-head {
    display: flex;
    gap: var(--space-2);
    align-items: center;
    flex-wrap: wrap;
  }

  .panel-block-head > b {
    margin-inline-end: auto;
  }

  .panel-kept {
    padding-inline-start: var(--space-5);
    color: var(--ink-2);
  }

  .panel-pager {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .panel-pager > button[aria-current="page"] {
    border: var(--rule) solid var(--orange);
    background: var(--highlight);
  }

  .panel-nav {
    padding-inline-start: var(--space-5);
  }
</style>
