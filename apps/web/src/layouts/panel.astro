---
import "@fontsource-variable/source-sans-3/wght.css";
import sourceSans from "@fontsource-variable/source-sans-3/files/source-sans-3-latin-wght-normal.woff2?url";

import { panelSections } from "../data/panel-sections.ts";
import { bootScript } from "../lib/preferences.ts";

import "../styles/global.css";
import "../styles/panel.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
const here = Astro.url.pathname.replace(/\/$/u, "");
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <script is:inline set:html={bootScript} />
    <link rel="preload" href={sourceSans} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#panel-tresc">
      Przejdź do treści
    </a>
    <header class="panel-header">
      <a class="panel-home" href="/panel">
        Panel ZSM3
      </a>
      <div class="panel-account">
        <p class="panel-user" data-panel="panel-user"></p>
        <a class="panel-site" href="/">
          Strona szkoły
        </a>
        <a class="panel-logout" data-panel="panel-logout" href="/cdn-cgi/access/logout" hidden>
          Wyloguj
        </a>
      </div>
    </header>
    <nav class="panel-tabs" aria-label="Sekcje panelu" data-panel="tabs">
      <ul>
        {panelSections.map((section) => (
          <li>
            <a
              href={section.href}
              aria-current={here === section.href ? "page" : undefined}
              data-admin={section.admin === true ? "" : undefined}
            >
              {section.short}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <main id="panel-tresc" class="page panel-main">
      <slot />
    </main>
  </body>
</html>
