---
import "@fontsource-variable/archivo/wdth.css";
import "@fontsource-variable/source-sans-3/wght.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import sourceSans from "@fontsource-variable/source-sans-3/files/source-sans-3-latin-wght-normal.woff2?url";

import { panelSections } from "../data/panel-sections.ts";
import { SECTION_GROUPS, sectionsIn } from "../lib/panel/overview.ts";
import { bootScript } from "../lib/preferences.ts";

import "../styles/global.css";
import "../styles/panel.css";
import "../styles/panel-shell.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
const here = Astro.url.pathname.replace(/\/$/u, "");
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="robots" content="noindex" />
    <script is:inline set:html={bootScript} />
    <link rel="preload" href={sourceSans} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#panel-tresc">
      Przejdź do treści
    </a>
    <div class="panel-shell">
      <div class="panel-side">
        <header class="panel-header">
          <a class="panel-home" href="/panel">
            <img src="/logo-zsm3.png" alt="" width="112" height="112" />
            Panel ZSM3
          </a>
          <button type="button" class="panel-menu-open" popovertarget="panel-nav">
            Menu
          </button>
        </header>
        <nav id="panel-nav" class="panel-nav" aria-label="Sekcje panelu" data-panel="tabs" popover>
          <button
            type="button"
            class="panel-menu-close"
            popovertarget="panel-nav"
            popovertargetaction="hide"
          >
            Zamknij menu
          </button>
          {SECTION_GROUPS.map((group) => (
            <div class="panel-nav-group">
              <p class="panel-nav-title" id={`panel-grupa-${group.id}`}>
                {group.title}
              </p>
              <ul aria-labelledby={`panel-grupa-${group.id}`}>
                {sectionsIn(panelSections, group.id).map((section) => (
                  <li>
                    <a
                      href={section.href}
                      aria-current={here === section.href ? "page" : undefined}
                      data-roles={section.roles?.join(" ")}
                    >
                      {section.short}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
          <div class="panel-account">
            <p class="panel-user" data-panel="panel-user"></p>
            <a class="panel-site" href="/">
              Strona szkoły <span aria-hidden="true">↗</span>
            </a>
            <a class="panel-logout" data-panel="panel-logout" href="/cdn-cgi/access/logout" hidden>
              Wyloguj
            </a>
          </div>
        </nav>
      </div>
      <main id="panel-tresc" class="panel-main">
        <slot />
      </main>
    </div>
  </body>
</html>
