---
import "@fontsource-variable/archivo/wdth.css";
import "@fontsource-variable/source-sans-3/wght.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "@fontsource/atkinson-hyperlegible-next/400.css";
import "@fontsource/atkinson-hyperlegible-next/700.css";
import archivo from "@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url";
import sourceSans from "@fontsource-variable/source-sans-3/files/source-sans-3-latin-wght-normal.woff2?url";
import { PATTERN_LIBRARY } from "astro:env/server";

import AccessibilityDialog from "../components/AccessibilityDialog.astro";
import AnnouncementBanner from "../components/AnnouncementBanner.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ContactPreviewForm from "../components/ContactPreviewForm.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { school } from "../data/site.ts";
import type { Announcement } from "../lib/announcement.ts";
import type { Crumb } from "../lib/breadcrumbs.ts";
import { bootScript } from "../lib/preferences.ts";
import { canonicalUrl, jsonLd, shouldNoindex, SITE_ORIGIN } from "../lib/seo.ts";

import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  breadcrumbs?: readonly Crumb[];
  announcement?: Announcement;
  structuredData?: object | readonly object[];
}

const {
  title,
  description,
  noindex = false,
  breadcrumbs,
  announcement,
  structuredData,
} = Astro.props;
const canonical = canonicalUrl(Astro.url);
const breadcrumbData =
  breadcrumbs === undefined
    ? undefined
    : {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: breadcrumbs.map((crumb, index) => ({
          "@type": "ListItem",
          position: index + 1,
          name: crumb.label,
          item: new URL(crumb.href ?? Astro.url.pathname, SITE_ORIGIN).href,
        })),
      };
const schoolData =
  Astro.url.pathname === "/"
    ? {
        "@context": "https://schema.org",
        "@type": "HighSchool",
        name: school.name,
        url: canonical,
        telephone: school.phone,
        geo: {
          "@type": "GeoCoordinates",
          latitude: school.latitude,
          longitude: school.longitude,
        },
        address: {
          "@type": "PostalAddress",
          streetAddress: school.street,
          postalCode: school.postalCode,
          addressLocality: school.city,
          addressCountry: "PL",
        },
      }
    : undefined;
const schemas = [
  schoolData,
  breadcrumbData,
  ...(Array.isArray(structuredData) ? structuredData : [structuredData]),
].filter((schema) => schema !== undefined);
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(noindex || shouldNoindex(Astro.url)) && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="pl_PL" />
    <meta name="twitter:card" content="summary" />
    {Astro.url.pathname === "/aktualnosci" && (
      <link
        rel="alternate"
        type="application/rss+xml"
        title="Aktualności ZSM3"
        href="/aktualnosci/rss.xml"
      />
    )}
    {schemas.map((schema) => (
      <script type="application/ld+json" set:html={jsonLd(schema)} />
    ))}
    <script is:inline set:html={bootScript} />
    <link rel="preload" href={archivo} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sourceSans} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
  </head>
  <body>
    <div class="scroll-sentinel" aria-hidden="true" data-scroll-sentinel></div>
    <a class="skip-link" href="#tresc">
      Przejdź do treści
    </a>
    {announcement !== undefined && <AnnouncementBanner announcement={announcement} />}
    <SiteHeader path={Astro.url.pathname} />
    <div class="page">{breadcrumbs !== undefined && <Breadcrumbs items={breadcrumbs} />}</div>
    <main id="tresc" class="page">
      <slot />
    </main>
    <SiteFooter />
    <AccessibilityDialog />
    {PATTERN_LIBRARY && <ContactPreviewForm />}
    <script>
      import "../scripts/frame.ts";
    </script>
  </body>
</html>

<style>
  .scroll-sentinel {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: var(--space-8);
    pointer-events: none;
  }
</style>
