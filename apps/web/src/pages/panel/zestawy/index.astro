---
import Panel from "../../../layouts/panel.astro";
import { DATASET_FORMS } from "../../../lib/panel/dataset-forms.ts";
---

<Panel title="Dane stron w panelu — ZSM3">
  <div class="panel-page" data-panel-page="datasets">
    <div class="panel-gate" data-panel="gate">
      <div class="panel-note" data-panel="gate-text" role="status" aria-live="polite">
        <p>Sprawdzam dostęp do panelu…</p>
      </div>
      <button type="button" data-panel="gate-retry">
        Ponów próbę
      </button>
    </div>
    <div data-panel="app" hidden>
      <h1>Dane stron</h1>
      <p>Kadra, wywiadówki, kontakty, wzory dokumentów, partnerzy i oferty pracy.</p>
      <label class="panel-inline">
        Zestaw danych
        <select data-panel="dataset">
          {DATASET_FORMS.map((form) => (
            <option value={form.key}>{form.title}</option>
          ))}
        </select>
      </label>
      <p data-panel="dataset-intro"></p>
      <p>
        <a data-panel="dataset-page" href="/">
          Zobacz na stronie
        </a>
      </p>
      <form class="panel-form" data-panel="dataset-form">
        <div data-panel="dataset-fields"></div>
        <div class="panel-actions">
          <button type="submit" class="panel-save">
            Zapisz zestaw
          </button>
        </div>
      </form>
      <p class="panel-note" data-panel="status" role="status" aria-live="polite"></p>
      <section class="panel-history" data-panel="history" hidden>
        <h2>Historia zmian</h2>
        <p class="panel-note" data-panel="history-status" role="status" aria-live="polite"></p>
        <ul data-panel="history-rows"></ul>
      </section>
    </div>
  </div>
</Panel>

<script>
  import "../../../scripts/panel/zestawy.ts";
</script>
