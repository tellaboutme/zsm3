---
import Panel from "../../layouts/panel.astro";
---

<Panel title="Panel — ZSM3">
  <div class="panel-page" data-panel-page="overview">
    <div class="panel-gate" data-panel="gate">
      <div class="panel-note" data-panel="gate-text" role="status" aria-live="polite">
        <p>Sprawdzam dostęp do panelu…</p>
      </div>
      <button type="button" data-panel="gate-retry">
        Ponów próbę
      </button>
    </div>
    <div data-panel="app" hidden>
      <h1>Panel obsługi treści</h1>
      <p>
        Z tego miejsca redagujesz aktualności, strony, terminarz, dokumenty, ogłoszenia i dzwonki
        szkoły.
      </p>
      <nav aria-label="Sekcje panelu" data-panel="sections">
        <ul class="panel-nav">
          <li>
            <a href="/panel/aktualnosci">Aktualności</a>
          </li>
          <li>
            <a href="/panel/strony">Strony</a>
          </li>
          <li>
            <a href="/panel/terminarz">Terminarz</a>
          </li>
          <li>
            <a href="/panel/dokumenty">Dokumenty</a>
          </li>
          <li>
            <a href="/panel/ogloszenia">Ogłoszenia</a>
          </li>
          <li>
            <a href="/panel/zestawy">Dane stron (kadra, kontakty, dokumenty, oferty pracy…)</a>
          </li>
          <li>
            <a href="/panel/dzwonki">Dzwonki</a>
          </li>
          <li>
            <a href="/panel/pracownicy" data-admin>
              Pracownicy i role
            </a>
          </li>
          <li>
            <a href="/panel/dziennik" data-admin>
              Dziennik zmian
            </a>
          </li>
          <li>
            <a href="/panel/przekierowania" data-admin>
              Przekierowania
            </a>
          </li>
        </ul>
      </nav>
      <p class="panel-meta">Każda zmiana trafia na stronę od razu po zapisaniu.</p>
    </div>
  </div>
</Panel>

<script>
  import "../../scripts/panel/index.ts";
</script>
