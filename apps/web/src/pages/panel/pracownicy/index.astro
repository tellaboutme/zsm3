---
import Panel from "../../../layouts/panel.astro";
import { STAFF_ROLE_OPTIONS } from "../../../lib/panel/staff.ts";
---

<Panel title="Pracownicy i role w panelu — ZSM3">
  <div class="panel-page" data-panel-page="staff">
    <div class="panel-gate" data-panel="gate">
      <div class="panel-note" data-panel="gate-text" role="status" aria-live="polite">
        <p>Sprawdzam dostęp do panelu…</p>
      </div>
      <button type="button" data-panel="gate-retry">
        Ponów próbę
      </button>
    </div>
    <div data-panel="app" hidden>
      <h1>Pracownicy i role</h1>
      <p>
        Do panelu wchodzą tylko osoby z tej listy. Rola decyduje, co dana osoba może zmieniać.
        Wyłączone konto traci dostęp przy następnym żądaniu.
      </p>
      <form class="panel-row panel-form" data-panel="staff-form">
        <label class="panel-inline">
          Szkolny adres e-mail
          <input name="email" type="email" data-panel="email" maxlength="320" required />
        </label>
        <label class="panel-inline">
          Rola
          <select name="role" data-panel="role">
            {STAFF_ROLE_OPTIONS.map((option) => (
              <option value={option.value}>{option.label}</option>
            ))}
          </select>
        </label>
        <button type="submit" class="panel-save">
          Dodaj pracownika
        </button>
      </form>
      <p class="panel-note" data-panel="status" role="status" aria-live="polite"></p>
      <ul data-panel="staff-rows"></ul>
    </div>
  </div>
</Panel>

<script>
  import "../../../scripts/panel/pracownicy.ts";
</script>

<style is:global>
  [data-panel-page="staff"] .panel-inline {
    min-width: 0;
    max-width: 100%;
  }

  [data-panel-page="staff"] .panel-inline select {
    width: 100%;
    min-width: 0;
  }
</style>
