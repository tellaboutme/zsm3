---
import { ANSWER_MAX_LENGTH, QUESTION_MAX_LENGTH } from "@zsm3/contracts/questions";

import Panel from "../../../layouts/panel.astro";
import { QUESTION_STATUS_LABELS } from "../../../lib/panel/questions.ts";

import "../../../styles/panel-requests.css";
import "../../../styles/panel-questions.css";

const statuses = Object.entries(QUESTION_STATUS_LABELS);
---

<Panel title="Skrzynka — ZSM3">
  <div class="panel-page" data-panel-page="questions">
    <div class="panel-gate" data-panel="gate">
      <div class="panel-note" data-panel="gate-text" role="status" aria-live="polite">
        <p>Sprawdzam dostęp do panelu…</p>
      </div>
      <button type="button" data-panel="gate-retry">
        Ponów próbę
      </button>
    </div>
    <div class="panel-page" data-panel="app" hidden>
      <h1>Skrzynka #OgarniamŻycie</h1>
      <p>
        Anonimowe pytania uczniów. Nic nie trafia na stronę bez Twojej decyzji. Opublikuj tylko
        pytania, które mogą pomóc też innym, i najpierw usuń z nich wszystko, po czym można kogoś
        rozpoznać.
      </p>
      <p class="panel-warning">
        Jeśli pytanie wskazuje, że komuś grozi niebezpieczeństwo, nie odpowiadaj w Skrzynce.
        Postępuj zgodnie ze szkolnymi standardami ochrony małoletnich i od razu powiadom osobę
        odpowiedzialną w szkole.
      </p>
      <div class="panel-row">
        <label class="panel-inline">
          Status
          <select name="status" data-panel="questions-filter">
            <option value="all">Wszystkie</option>
            {statuses.map(([value, label]) => (
              <option value={value}>{label}</option>
            ))}
          </select>
        </label>
        <button type="button" data-panel="questions-refresh">
          Odśwież listę
        </button>
      </div>
      <p class="panel-note" data-panel="status" role="status" aria-live="polite"></p>
      <div class="panel-columns">
        <section class="panel-page" aria-labelledby="skrzynka-lista">
          <h2 id="skrzynka-lista">Lista pytań</h2>
          <ul data-panel="question-rows"></ul>
          <div class="panel-actions">
            <button type="button" data-panel="questions-more" hidden>
              Pokaż starsze
            </button>
          </div>
        </section>
        <section
          class="panel-request"
          data-panel="question-detail"
          aria-labelledby="pytanie-tytul"
          hidden
        >
          <h2 id="pytanie-tytul" tabindex="-1" data-panel="question-title">
            Pytanie
          </h2>
          <p class="panel-meta" data-panel="question-meta"></p>
          <p class="panel-note" data-panel="question-feedback" role="status" aria-live="polite"></p>
          <section class="panel-question-original" aria-labelledby="pytanie-oryginal">
            <h3 id="pytanie-oryginal">Treść od ucznia</h3>
            <p class="panel-warning" data-panel="question-erased" hidden></p>
            <div class="panel-question-text" data-panel="question-original"></div>
          </section>
          <p data-panel="question-public" hidden>
            <a data-panel="question-public-link" href="/skrzynka">
              Zobacz na stronie
            </a>
          </p>
          <form class="panel-form" data-panel="question-editor" hidden>
            <label for="szkic-pytanie">Pytanie do publikacji</label>
            <p id="szkic-pytanie-opis" class="panel-note">
              Przepisz pytanie tak, aby nie dało się rozpoznać autora ani innych osób.
            </p>
            <textarea
              id="szkic-pytanie"
              name="draftQuestion"
              rows="6"
              maxlength={QUESTION_MAX_LENGTH}
              aria-describedby="szkic-pytanie-opis"
            ></textarea>
            <label for="szkic-odpowiedz">Odpowiedź</label>
            <textarea
              id="szkic-odpowiedz"
              name="draftAnswer"
              rows="10"
              maxlength={ANSWER_MAX_LENGTH}
            ></textarea>
            <div class="panel-actions">
              <button type="submit" class="panel-save" data-panel="question-save">
                Zapisz szkic
              </button>
            </div>
          </form>
          <div class="panel-actions" data-panel="question-actions"></div>
          <div class="panel-confirm" data-panel="question-confirm" hidden>
            <p id="pytanie-potwierdzenie" data-panel="confirm-text"></p>
            <div class="panel-actions">
              <button
                type="button"
                class="panel-save"
                data-panel="confirm-yes"
                aria-describedby="pytanie-potwierdzenie"
              ></button>
              <button type="button" data-panel="confirm-no">
                Anuluj
              </button>
            </div>
          </div>
          <section aria-labelledby="pytanie-historia">
            <h3 id="pytanie-historia">Historia zmian</h3>
            <ul class="panel-history" data-panel="question-history"></ul>
          </section>
        </section>
      </div>
    </div>
  </div>
</Panel>

<script>
  import "../../../scripts/panel/skrzynka.ts";
</script>
