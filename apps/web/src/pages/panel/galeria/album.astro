---
import Panel from "../../../layouts/panel.astro";

import "../../../styles/panel-gallery.css";
---

<Panel title="Album — galeria — ZSM3">
  <div class="panel-page" data-panel-page="gallery-album">
    <div class="panel-gate" data-panel="gate">
      <div class="panel-note" data-panel="gate-text" role="status" aria-live="polite">
        <p>Sprawdzam dostęp do panelu…</p>
      </div>
      <button type="button" data-panel="gate-retry">
        Ponów próbę
      </button>
    </div>
    <div class="panel-page" data-panel="app" hidden>
      <p>
        <a href="/panel/galeria">Wróć do listy albumów</a>
      </p>
      <h1 data-panel="album-title" tabindex="-1">
        Album
      </h1>
      <p class="panel-meta" data-panel="album-state"></p>
      <p class="panel-note" data-panel="status" role="status" aria-live="polite"></p>
      <div class="panel-actions">
        <button type="button" class="panel-save" data-panel="album-publish" hidden>
          Opublikuj album
        </button>
        <button type="button" data-panel="album-unpublish" hidden>
          Ukryj album
        </button>
        <button type="button" data-panel="album-remove">
          Usuń album
        </button>
      </div>
      <form class="panel-form" data-panel="album-form">
        <fieldset>
          <legend>Dane albumu</legend>
          <label>
            Rok szkolny
            <select name="schoolYear" data-panel="album-year"></select>
          </label>
          <label>
            Tytuł
            <input type="text" name="title" maxlength="200" required />
          </label>
          <label>
            Adres (małe litery, cyfry i myślniki)
            <input type="text" name="slug" maxlength="120" required />
          </label>
          <label>
            Opis (nieobowiązkowy)
            <textarea name="description" rows="3" maxlength="2000"></textarea>
          </label>
          <div class="panel-actions">
            <button type="submit" class="panel-save">
              Zapisz album
            </button>
          </div>
        </fieldset>
      </form>
      <form class="panel-form" data-panel="photo-form">
        <fieldset>
          <legend>Dodaj zdjęcie</legend>
          <label>
            Zdjęcie (JPG, PNG lub WebP)
            <input
              type="file"
              accept="image/jpeg,image/png,image/webp"
              data-panel="photo-file"
              required
            />
          </label>
          <label>
            Opis dla osób niewidomych
            <textarea rows="2" maxlength="300" required></textarea>
          </label>
          <label class="panel-check">
            <input type="checkbox" data-panel="photo-consent" required />
            Potwierdzam, że szkoła ma zgodę lub inną uzgodnioną podstawę prawną do publikacji tego
            zdjęcia. To potwierdzenie trafia do dziennika zmian, ale nie zastępuje samej zgody.
          </label>
          <progress class="panel-photo-progress" max="100" aria-label="Postęp" hidden></progress>
          <p class="panel-note" data-panel="photo-status" role="status" aria-live="polite"></p>
          <div class="panel-actions">
            <button type="submit" class="panel-save" data-panel="photo-send">
              Dodaj zdjęcie
            </button>
            <button type="button" data-panel="photo-cancel" hidden>
              Anuluj
            </button>
          </div>
        </fieldset>
      </form>
      <h2>Zdjęcia w albumie</h2>
      <ul class="panel-photo-list" data-panel="photo-rows"></ul>
    </div>
  </div>
</Panel>

<script>
  import "../../../scripts/panel/galeria-album.ts";
</script>
