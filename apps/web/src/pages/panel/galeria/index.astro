---
import Panel from "../../../layouts/panel.astro";
---

<Panel title="Galeria — ZSM3">
  <div class="panel-page" data-panel-page="gallery">
    <div class="panel-gate" data-panel="gate">
      <div class="panel-note" data-panel="gate-text" role="status" aria-live="polite">
        <p>Sprawdzam dostęp do panelu…</p>
      </div>
      <button type="button" data-panel="gate-retry">
        Ponów próbę
      </button>
    </div>
    <div class="panel-page" data-panel="app" hidden>
      <h1>Galeria</h1>
      <p>Albumy są niewidoczne na stronie szkoły, dopóki ich nie opublikujesz.</p>
      <form class="panel-form" data-panel="album-form">
        <fieldset>
          <legend>Nowy album</legend>
          <label>
            Rok szkolny
            <select name="schoolYear" data-panel="album-year"></select>
          </label>
          <label>
            Tytuł
            <input type="text" name="title" maxlength="200" required />
          </label>
          <label>
            Opis (nieobowiązkowy)
            <input type="text" name="description" maxlength="2000" />
          </label>
          <p class="panel-note" data-panel="album-form-status" role="status" aria-live="polite"></p>
          <div class="panel-actions">
            <button type="submit" class="panel-save">
              Utwórz album
            </button>
          </div>
        </fieldset>
      </form>
      <h2>Albumy</h2>
      <label class="panel-inline">
        Rok szkolny
        <select data-panel="album-filter">
          <option value="">Wszystkie</option>
        </select>
      </label>
      <p class="panel-note" data-panel="status" role="status" aria-live="polite"></p>
      <ul data-panel="album-rows"></ul>
    </div>
  </div>
</Panel>

<script>
  import "../../../scripts/panel/galeria.ts";
</script>
