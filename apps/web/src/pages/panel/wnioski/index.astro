---
import Panel from "../../../layouts/panel.astro";
import { REQUEST_STATUS_LABELS } from "../../../lib/panel/requests.ts";

import "../../../styles/panel-requests.css";

const statuses = Object.entries(REQUEST_STATUS_LABELS);
---

<Panel title="Wnioski — ZSM3">
  <div class="panel-page" data-panel-page="requests">
    <div class="panel-gate" data-panel="gate">
      <div class="panel-note" data-panel="gate-text" role="status" aria-live="polite">
        <p>Sprawdzam dostęp do panelu…</p>
      </div>
      <button type="button" data-panel="gate-retry">
        Ponów próbę
      </button>
    </div>
    <div data-panel="app" hidden>
      <h1>Wnioski</h1>
      <p>
        Wnioski o legitymację i zaświadczenie złożone przez formularz e-wniosek. Najnowsze są na
        górze. Dane wnioskodawcy widać tylko w szczegółach wniosku.
      </p>
      <div class="panel-row">
        <label class="panel-inline">
          Status
          <select name="status" data-panel="requests-filter">
            <option value="all">Wszystkie</option>
            {statuses.map(([value, label]) => (
              <option value={value}>{label}</option>
            ))}
          </select>
        </label>
        <button type="button" data-panel="requests-refresh">
          Odśwież listę
        </button>
      </div>
      <p class="panel-note" data-panel="status" role="status" aria-live="polite"></p>
      <div class="panel-columns">
        <section class="panel-page" aria-labelledby="wnioski-lista">
          <h2 id="wnioski-lista">Lista wniosków</h2>
          <ul data-panel="request-rows"></ul>
          <div class="panel-actions">
            <button type="button" data-panel="requests-more" hidden>
              Pokaż starsze
            </button>
          </div>
        </section>
        <section class="panel-request" data-panel="request-detail" aria-labelledby="wniosek" hidden>
          <h2 id="wniosek" tabindex="-1" data-panel="request-title">
            Szczegóły wniosku
          </h2>
          <p class="panel-meta" data-panel="request-id"></p>
          <p class="panel-warning" data-panel="request-pii" hidden></p>
          <dl class="panel-facts" data-panel="request-facts"></dl>
          <p class="panel-note" data-panel="request-feedback" role="status" aria-live="polite"></p>
          <div class="panel-actions" data-panel="request-actions"></div>
          <div class="panel-confirm" data-panel="request-confirm" hidden>
            <p id="wniosek-potwierdzenie" data-panel="confirm-text"></p>
            <div class="panel-actions">
              <button
                type="button"
                class="panel-save"
                data-panel="confirm-yes"
                aria-describedby="wniosek-potwierdzenie"
              ></button>
              <button type="button" data-panel="confirm-no">
                Anuluj
              </button>
            </div>
          </div>
        </section>
      </div>
    </div>
  </div>
</Panel>

<script>
  import "../../../scripts/panel/wnioski.ts";
</script>
