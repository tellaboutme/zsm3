---
import PageHead from "../components/PageHead.astro";
import SiteMapTree from "../components/SiteMapTree.astro";
import { buildSiteMap } from "../data/site-map.ts";
import Base from "../layouts/Base.astro";
import { flattenMap } from "../lib/site-map.ts";
import { programmeData } from "../server/datasets.ts";
import { pagesReader } from "../server/pages.ts";

export const prerender = false;

const siteMap = buildSiteMap(await pagesReader().published(), await programmeData());
---

<Base
  title="Mapa strony — ZSM3"
  description="Wszystkie strony serwisu Zespołu Szkół Mechanicznych nr 3 w jednym miejscu."
  breadcrumbs={[{ label: "Mapa strony" }]}
>
  <div class="site-map">
    <PageHead title="Mapa strony" lead="Wszystkie strony serwisu, uporządkowane tak jak w menu.">
      <Fragment slot="meta">{flattenMap(siteMap).length} stron</Fragment>
    </PageHead>
    <nav aria-label="Mapa strony">
      <SiteMapTree nodes={siteMap} />
    </nav>
  </div>
</Base>

<style>
  .site-map {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-7);
    padding-block: var(--space-7);
  }
</style>
