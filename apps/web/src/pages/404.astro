---
import Base from "../layouts/Base.astro";
---

<Base title="Nie znaleziono strony" description="Strona o podanym adresie nie istnieje.">
  <section class="missing" aria-labelledby="tytul">
    <p class="tag">Błąd 404</p>
    <h1 id="tytul">Nie znaleziono strony</h1>
    <p>
      <a href="/">Przejdź do strony głównej</a>
    </p>
  </section>
</Base>

<style>
  .missing {
    display: grid;
    gap: var(--space-5);
    padding-block: var(--space-8);
  }

  h1 {
    font-size: var(--step-3);
  }
</style>
