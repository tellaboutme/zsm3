---
import Base from "../../layouts/Base.astro";
import { isoDay, longDate } from "../../lib/calendar.ts";
import { meetings as meetingData } from "../../server/datasets.ts";

export const prerender = false;

const meetingPlan = await meetingData();
const gradeRooms = meetingPlan.grades;

const meetings = (Astro.locals.events ?? []).filter((event) => event.kind === "zebranie");
const today = isoDay(new Date());
const next = meetings.find((event) => event.date >= today);
---

<Base
  title="Wywiadówki — ZSM3"
  description="Terminy zebrań z rodzicami w roku szkolnym 2026/2027 i sale, w których spotykają się klasy."
  breadcrumbs={[{ label: "Rodzice", href: "/rodzice" }, { label: "Wywiadówki" }]}
>
  <div class="meetings">
    <header class="intro">
      <p class="tag">Rodzice · zebrania</p>
      <h1>
        <span class="rise">
          <span>Wywiadówki</span>
        </span>
      </h1>
      <p class="lead">Terminy zebrań z rodzicami i sale, w których spotykają się klasy.</p>
    </header>
    <section class="next" aria-labelledby="najblizsze" data-dated>
      <h2 id="najblizsze" class="tag">
        Najbliższe zebranie
      </h2>
      <p class="big">{next === undefined ? "Brak zaplanowanych zebrań" : longDate(next.date)}</p>
      <ol class="dates">
        {meetings.map((event) => (
          <li class:list={{ past: event.date < today }}>
            <time datetime={event.date}>{longDate(event.date)}</time>
          </li>
        ))}
      </ol>
    </section>
    <section aria-labelledby="przebieg">
      <h2 id="przebieg">Przebieg zebrania</h2>
      <p class="source">
        Według harmonogramu zebrania z {longDate(meetingPlan.date)} ({meetingPlan.order})
      </p>
      <ol class="steps">
        {meetingPlan.steps.map((step) => (
          <li>
            <span class="time">{step.time}</span>
            <span>{step.text}</span>
          </li>
        ))}
      </ol>
    </section>
    <section aria-labelledby="sale">
      <h2 id="sale">Sale klas</h2>
      <div class="grades">
        {gradeRooms.map((grade) => (
          <table>
            <caption>{grade.grade}</caption>
            <thead>
              <tr>
                <th scope="col">Klasa</th>
                <th scope="col">Sala</th>
              </tr>
            </thead>
            <tbody>
              {grade.classes.map((entry) => (
                <tr>
                  <th scope="row">{entry.name}</th>
                  <td class="mono">{entry.room}</td>
                </tr>
              ))}
            </tbody>
          </table>
        ))}
      </div>
      <p class="note">
        Pozostali nauczyciele dyżurują w pokoju nauczycielskim lub na zapleczach. Gdzie ich znaleźć,
        powie sekretariat uczniowski.
      </p>
    </section>
  </div>
</Base>

<style>
  .meetings {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-7);
    padding-block: var(--space-7);
  }

  .intro,
  section {
    display: grid;
    gap: var(--space-4);
  }

  .tag,
  .source,
  .note {
    color: var(--ink-2);
  }

  h1 {
    font-size: var(--step-title);
    font-stretch: var(--stretch-wide);
  }

  h2 {
    font-size: var(--step-3);
  }

  .lead {
    max-width: var(--measure);
    font-size: var(--step-1);
  }

  .next {
    max-width: 40rem;
    padding: var(--space-5);
    border-radius: var(--radius);
    background: var(--blue);
    color: var(--blue-ink);
  }

  .next .tag {
    color: var(--blue-dim);
    font-family: var(--font-mono);
    font-size: var(--step-n1);
    font-weight: 400;
    text-transform: uppercase;
  }

  .big {
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 800;
    line-height: var(--leading-tight);
  }

  .dates {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
  }

  .dates .past {
    color: var(--blue-dim);
    text-decoration: line-through;
  }

  .steps {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .steps li {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr);
    gap: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: var(--hairline) solid var(--line);
  }

  .time {
    font-family: var(--font-mono);
    font-weight: 600;
  }

  .grades {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 13rem), 1fr));
    gap: var(--space-5);
    align-items: start;
  }

  table {
    width: 100%;
    border-collapse: collapse;
  }

  caption {
    padding-bottom: var(--space-2);
    font-weight: 800;
    text-align: left;
  }

  th,
  td {
    padding: var(--space-2) var(--space-3) var(--space-2) 0;
    border-bottom: var(--hairline) solid var(--line);
    text-align: left;
  }

  thead th {
    color: var(--ink-2);
    font-family: var(--font-mono);
    font-size: var(--step-n1);
    font-weight: 400;
    text-transform: uppercase;
  }
</style>
