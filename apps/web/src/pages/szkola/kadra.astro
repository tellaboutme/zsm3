---
import Callout from "../../components/content/Callout.astro";
import PageHead from "../../components/PageHead.astro";
import PersonRow from "../../components/people/PersonRow.astro";
import Base from "../../layouts/Base.astro";
import { staffDirectory } from "../../server/datasets.ts";

export const prerender = false;

const staffGroups = await staffDirectory();
---

<Base
  title="Kadra — ZSM3"
  description="Dyrekcja, specjaliści wspierający uczniów oraz nauczyciele przedmiotów zawodowych i ogólnokształcących w Zespole Szkół Mechanicznych nr 3."
  breadcrumbs={[{ label: "Szkoła", href: "/szkola" }, { label: "Kadra" }]}
>
  <div class="staff">
    <PageHead
      title="Kadra"
      lead="Nauczyciele przedmiotów zawodowych i ogólnokształcących, specjaliści wspierający uczniów oraz dyrekcja szkoły."
    >
      <Fragment slot="meta">Rok szkolny 2026/2027</Fragment>
    </PageHead>
    {staffGroups.map((group) => (
      <section class="group" aria-labelledby={group.id}>
        <h2 id={group.id}>{group.title}</h2>
        <p class="summary">{group.summary}</p>
        {group.people.length > 0 && (
          <ul class="people">
            {group.people.map((person) => (
              <PersonRow person={person} />
            ))}
          </ul>
        )}
        {group.subjects.length > 0 && (
          <ul class="subjects" aria-label={`Przedmioty: ${group.title}`}>
            {group.subjects.map((subject) => (
              <li>{subject}</li>
            ))}
          </ul>
        )}
      </section>
    ))}
    <Callout
      title="Kontakt z nauczycielem"
      text="Z nauczycielami można skontaktować się przez dziennik Librus lub przez sekretariat uczniowski."
      link={{ label: "Telefony i adresy szkoły", href: "/kontakt" }}
    />
  </div>
</Base>

<style>
  .staff {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-7);
    padding-block: var(--space-7);
  }

  .group {
    display: grid;
    gap: var(--space-3);
  }

  .summary {
    color: var(--ink-2);
  }

  h2 {
    font-size: var(--step-2);
  }

  .people,
  .subjects {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .people {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: 0 var(--space-5);
  }

  .subjects {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .subjects li {
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius);
    background: var(--surface);
    font-size: var(--step-n1);
  }
</style>
