---
import Base from "../../layouts/Base.astro";

export const prerender = false;
---

<Base
  title="Galeria — ZSM3"
  description="Galeria Zespołu Szkół Mechanicznych nr 3 w Krakowie. Obecnie nie ma w niej opublikowanych zdjęć."
  breadcrumbs={[{ label: "Szkoła", href: "/szkola" }, { label: "Galeria" }]}
>
  <div class="gallery">
    <header class="intro">
      <p class="tag">Szkoła · galeria</p>
      <h1>
        <span class="rise">
          <span>Galeria</span>
        </span>
      </h1>
    </header>
    <section aria-labelledby="brak-zdjec">
      <h2 id="brak-zdjec">Brak zdjęć w galerii</h2>
      <p>W galerii nie ma obecnie opublikowanych albumów ani zdjęć.</p>
    </section>
  </div>
</Base>

<style>
  .gallery {
    display: grid;
    gap: var(--space-7);
    padding-block: var(--space-7);
  }

  .intro {
    display: grid;
    gap: var(--space-4);
  }

  .tag {
    color: var(--ink-2);
  }

  h1 {
    font-size: var(--step-title);
    font-stretch: var(--stretch-wide);
  }

  section {
    display: grid;
    gap: var(--space-5);
  }

  h2 {
    font-size: var(--step-3);
  }
</style>
