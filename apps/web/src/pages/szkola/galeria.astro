---
import MediaPlaceholder from "../../components/MediaPlaceholder.astro";
import Base from "../../layouts/Base.astro";

const albums = [
  { title: "Pracownie mechatroniczne", note: "Stanowiska sterowania i montażu układów." },
  { title: "Warsztaty samochodowe", note: "Diagnostyka i obsługa pojazdów." },
  { title: "Pracownie lotnicze", note: "Obsługa techniczna i sprzęt lotniskowy." },
  { title: "Pracownie informatyczne", note: "Sieci, serwerownia i stanowiska programistyczne." },
  { title: "Erasmus+", note: "Praktyki i wyjazdy zagraniczne uczniów." },
  { title: "Dzień Patrona", note: "Ślubowanie klas pierwszych i uroczystości szkolne." },
];

export const prerender = false;
---

<Base
  title="Galeria — ZSM3"
  description="Zdjęcia pracowni, warsztatów i wydarzeń Zespołu Szkół Mechanicznych nr 3 w Krakowie."
  breadcrumbs={[{ label: "Szkoła", href: "/szkola" }, { label: "Galeria" }]}
>
  <div class="gallery">
    <header class="intro">
      <p class="tag">Szkoła · zdjęcia</p>
      <h1>
        <span class="rise">
          <span>Galeria</span>
        </span>
      </h1>
      <p class="lead">
        Pracownie, warsztaty i wydarzenia szkolne. Albumy przygotowujemy do publikacji — zdjęcia
        trafiają na stronę po zebraniu zgód na wykorzystanie wizerunku.
      </p>
    </header>
    <section aria-labelledby="albumy">
      <h2 id="albumy">Albumy</h2>
      <ul class="grid">
        {albums.map((album) => (
          <li class="reveal">
            <h3>{album.title}</h3>
            <MediaPlaceholder shape="wide" />
            <p class="note">{album.note}</p>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Base>

<style>
  .gallery {
    display: grid;
    gap: var(--space-7);
    padding-block: var(--space-7) var(--space-8);
  }

  .intro {
    display: grid;
    gap: var(--space-4);
  }

  .tag {
    color: var(--ink-2);
  }

  h1 {
    font-size: var(--step-title);
    font-stretch: var(--stretch-wide);
  }

  .lead {
    max-width: var(--measure);
    font-size: var(--step-1);
    line-height: var(--leading-snug);
  }

  section {
    display: grid;
    gap: var(--space-5);
  }

  h2 {
    font-size: var(--step-3);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .grid li {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    min-width: 0;
    padding-top: var(--space-4);
    border-top: var(--hairline) solid var(--line);
  }

  h3 {
    font-size: var(--step-1);
    line-height: var(--leading-snug);
  }

  .note {
    color: var(--ink-2);
  }
</style>
