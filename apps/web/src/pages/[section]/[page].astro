---
import ContentPageView from "../../components/content/ContentPageView.astro";
import { notFound } from "../../server/news.ts";
import { pagesReader } from "../../server/pages.ts";

export const prerender = false;

const page = await pagesReader().find(
  `/${Astro.params["section"] ?? ""}/${Astro.params["page"] ?? ""}`,
);
if (page === undefined) {
  return notFound();
}
---

<ContentPageView page={page} />
