---
import { featuredSlotSchema } from "@zsm3/contracts/featured";

import ContentPageView from "../../components/content/ContentPageView.astro";
import TaskGroups from "../../components/hub/TaskGroups.astro";
import MenuFeature from "../../components/MenuFeature.astro";
import NewsCard from "../../components/news/NewsCard.astro";
import PageHead from "../../components/PageHead.astro";
import { hubs } from "../../data/hubs.ts";
import { publicFallbackNavigation } from "../../data/navigation.ts";
import Base from "../../layouts/Base.astro";
import { featuredImage } from "../../lib/featured.ts";
import { latestNews } from "../../lib/news-listing.ts";
import { featuredPhotos } from "../../server/featured.ts";
import { newsReader, notFound } from "../../server/news.ts";
import { pagesReader } from "../../server/pages.ts";

const { sections } = Astro.locals.navigation ?? publicFallbackNavigation;

export const prerender = false;

const slug = Astro.params["section"] ?? "";
const hub = hubs.find((candidate) => candidate.section === slug);
const section = sections.find((candidate) => candidate.id === hub?.section);
const page =
  hub === undefined || section === undefined ? await pagesReader().find(`/${slug}`) : undefined;
if (page === undefined && (hub === undefined || section === undefined)) {
  return notFound();
}
const [latest, featured] =
  page === undefined
    ? await Promise.all([latestNews(newsReader(), 3), featuredPhotos()])
    : [[], undefined];
const slot = featuredSlotSchema.safeParse(slug);
const photo = slot.success ? featured?.get(slot.data) : undefined;
const image = photo === undefined ? undefined : featuredImage(photo);
---

{page !== undefined && <ContentPageView page={page} />}
{hub !== undefined && section !== undefined && (
  <Base
    title={`${section.label} — ZSM3`}
    description={hub.intro}
    breadcrumbs={[{ label: section.label }]}
  >
    <div class="hub">
      <div class="top">
        <div class:list={["head", { photo: image !== undefined }]}>
          {image !== undefined && (
            <img
              class="backdrop"
              src={image.src}
              srcset={image.srcset}
              sizes="(width >= 64rem) 44rem, 100vw"
              width={image.width}
              height={image.height}
              alt={image.alt}
              fetchpriority="high"
              decoding="async"
            />
          )}
          <PageHead
            title={section.label}
            lead={hub.intro}
            class={image === undefined ? undefined : "on-photo"}
          >
            <a class="action nudge tap-target" href={hub.action.href}>
              {hub.action.label} <span aria-hidden="true">→</span>
            </a>
          </PageHead>
        </div>
        {section.featured !== undefined && (
          <div class="feature">
            <MenuFeature feature={section.featured} />
          </div>
        )}
      </div>
      <TaskGroups groups={section.groups} />
      <section class="news" aria-labelledby="aktualnosci">
        <h2 id="aktualnosci">Aktualności</h2>
        <ul>
          {latest.map((item) => (
            <li>
              <NewsCard item={item} />
            </li>
          ))}
        </ul>
        <a class="more nudge tap-target" href="/aktualnosci">
          Wszystkie aktualności <span aria-hidden="true">→</span>
        </a>
      </section>
    </div>
  </Base>
)}

<style>
  .hub {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-7);
    padding-block: var(--space-7);
  }

  .action {
    display: inline-flex;
    gap: var(--space-2);
    align-items: center;
    min-height: var(--target);
    padding: var(--space-3) var(--space-5);
    border-radius: var(--radius);
    background: var(--orange-surface);
    color: var(--orange-ink);
    font-weight: 700;
    text-decoration: none;
  }

  .top {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
    align-items: center;
  }

  .head.photo {
    position: relative;
    display: grid;
    align-content: end;
    min-block-size: clamp(18rem, 32vw, 26rem);
    overflow: hidden;
    border-radius: var(--radius);
    color: var(--on-photo);
  }

  .backdrop {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .news {
    display: grid;
    gap: var(--space-5);
  }

  .news h2 {
    font-size: var(--step-3);
  }

  .news ul {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .more {
    font-weight: 700;
  }

  @media (width >= 64rem) {
    .top {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
  }

  @media (width >= 56rem) {
    .news ul {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
