---
import ContactCards from "../components/ContactCards.astro";
import EmailText from "../components/EmailText.astro";
import Icon from "../components/Icon.astro";
import PageHead from "../components/PageHead.astro";
import { school } from "../data/site.ts";
import Base from "../layouts/Base.astro";
import { contacts } from "../server/datasets.ts";

export const prerender = false;

const { departments, management } = await contacts();
---

<Base
  title="Kontakt — ZSM3"
  description="Telefony i adresy e-mail sekretariatów, księgowości, Rady Rodziców i kierownictwa Zespołu Szkół Mechanicznych nr 3 w Krakowie."
  breadcrumbs={[{ label: "Kontakt" }]}
>
  <div class="contact">
    <PageHead class="intro" title="Kontakt">
      <Fragment slot="meta">
        {school.street}, {school.city}
      </Fragment>
      <div class="main">
        <a class="phone" href={`tel:${school.phone}`}>
          {school.phoneLabel}
        </a>
        <a href={`mailto:${school.email}`}>
          <EmailText email={school.email} />
        </a>
      </div>
    </PageHead>
    <section aria-labelledby="dzialy">
      <h2 id="dzialy">Sekretariaty i działy</h2>
      <ContactCards cards={departments} />
    </section>
    <section aria-labelledby="kierownictwo">
      <h2 id="kierownictwo">Kierownictwo i administracja</h2>
      <ContactCards cards={management} />
    </section>
    <section class="where" aria-labelledby="dojazd">
      <h2 id="dojazd">Jak do nas trafić</h2>
      <address>
        {school.name}
        <br />
        im. {school.patron}
        <br />
        {school.street}, {school.postalCode} {school.city}
      </address>
      <a class="map nudge" href={school.mapUrl}>
        Zobacz dojazd w Google Maps
        <Icon name="external" />
        <span class="visually-hidden">(otwiera serwis zewnętrzny)</span>
      </a>
      <p class="note">
        Google Maps otwiera się dopiero po kliknięciu. Samo wyświetlenie tej strony nie łączy się z
        Google.
      </p>
    </section>
  </div>
</Base>

<style>
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-7);
    padding-block: var(--space-7);
  }

  .intro,
  section {
    display: grid;
    gap: var(--space-4);
  }

  .note {
    color: var(--ink-2);
  }

  h2 {
    font-size: var(--step-3);
  }

  .main {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);
    align-items: baseline;
    font-size: var(--step-1);
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .phone {
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-stretch: var(--stretch-wide);
    font-variant-numeric: tabular-nums;
    font-weight: var(--weight-heading);
    text-decoration: none;
  }

  .phone:hover {
    text-decoration: underline;
  }

  .where {
    max-width: var(--measure);
    padding: var(--space-5);
    border: var(--hairline) solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .where h2 {
    font-size: var(--step-2);
  }

  address {
    font-style: normal;
    font-weight: 700;
  }

  .map {
    display: inline-flex;
    gap: var(--space-2);
    align-items: center;
    min-height: var(--target);
    font-weight: 700;
  }

  @media (width >= 56rem) {
    .contact {
      grid-template-columns: minmax(0, min(62%, 52rem)) minmax(18rem, 1fr);
      align-items: start;
    }

    .intro {
      grid-column: 1 / -1;
    }

    section[aria-labelledby="dzialy"] {
      grid-column: 1;
      grid-row: 2;
    }

    section[aria-labelledby="kierownictwo"] {
      grid-column: 1;
      grid-row: 3;
    }

    .where {
      grid-column: 2;
      grid-row: 2 / span 2;
    }
  }
</style>
