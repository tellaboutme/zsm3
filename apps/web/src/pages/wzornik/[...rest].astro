---
import { PATTERN_LIBRARY } from "astro:env/server";

import RichText from "../../components/content/RichText.astro";
import Base from "../../layouts/Base.astro";
import { richTextSample } from "../../pattern-library/rich-text-sample.ts";
import "../../pattern-library/wzornik.css";

export function getStaticPaths(): { params: { rest: undefined } }[] {
  return PATTERN_LIBRARY ? [{ params: { rest: undefined } }] : [];
}

const colours = [
  { token: "--bg", use: "tło strony" },
  { token: "--gray", use: "kafelki, paski, panele boczne" },
  { token: "--ink", use: "tekst" },
  { token: "--ink-2", use: "tekst pomocniczy" },
  { token: "--line", use: "linie i obramowania" },
  { token: "--blue", use: "powierzchnie marki z białym tekstem" },
  { token: "--blue-2", use: "ciemniejszy niebieski, stopka" },
  { token: "--link", use: "linki i niebieski tekst" },
  { token: "--orange", use: "główna akcja, postęp, fokus" },
  { token: "--success", use: "sukces" },
  { token: "--warning", use: "ostrzeżenie" },
  { token: "--danger", use: "błąd" },
];
const steps = ["--step-4", "--step-3", "--step-2", "--step-1", "--step-0", "--step-n1"];
const spaces = [
  "--space-1",
  "--space-2",
  "--space-3",
  "--space-4",
  "--space-5",
  "--space-6",
  "--space-7",
  "--space-8",
];
const sample = "Zażółć gęślą jaźń ŹŻĆŃĄŚŁĘÓ 0123456789";
---

<Base
  title="Wzornik — ZSM3"
  description="Fundament systemu wizualnego: kolory, typografia, odstępy, ruch, układy."
  noindex
  breadcrumbs={[{ label: "Wzornik" }]}
  announcement={{
    id: "wzornik-przyklad",
    severity: "important",
    text: "Przykładowy komunikat szkoły wyświetlany nad nagłówkiem.",
    link: { label: "Szczegóły", href: "#kolory" },
  }}
>
  <div class="pattern-library">
    <header class="head">
      <p class="tag">Wzornik komponentów</p>
      <h1>
        <span class="rise">
          <span>Fundament</span>
        </span>
        <span class="rise">
          <span>systemu wizualnego</span>
        </span>
      </h1>
      <p class="prose">
        Tokeny, typografia, odstępy, ruch i układy, na których opiera się każda strona. Ta strona
        istnieje tylko w wersji podglądowej.
      </p>
    </header>

    <section class="block" aria-labelledby="kolory">
      <h2 id="kolory" class="reveal">
        Kolory
      </h2>
      <ul class="swatches">
        {colours.map((colour) => (
          <li class="reveal">
            <span class={`chip ${colour.token.slice(2)}`} aria-hidden="true" />
            <code>{colour.token}</code>
            <span>{colour.use}</span>
          </li>
        ))}
      </ul>
      <div class="pairs">
        <p class="pair on-bg">Tekst na tle strony</p>
        <p class="pair on-gray">Tekst na szarym panelu</p>
        <p class="pair on-blue">Biały tekst na niebieskim</p>
        <p class="pair on-orange">Ciemny tekst na pomarańczowym</p>
      </div>
    </section>

    <section class="block" aria-labelledby="typografia">
      <h2 id="typografia" class="reveal">
        Typografia
      </h2>
      <ul class="scale">
        {steps.map((step) => (
          <li class="reveal">
            <code>{step}</code>
            <span class={`specimen ${step.slice(2)}`}>{sample}</span>
          </li>
        ))}
      </ul>
      <p class="faces">
        <span class="face-body">Source Sans 3 — tekst, nawigacja, formularze.</span>
        <span class="face-mono">IBM Plex Mono — INF.03 · 7:30–8:15 · W6</span>
        <span class="face-readable">
          Atkinson Hyperlegible Next — krój czytelny w ustawieniach.
        </span>
      </p>
    </section>

    <section class="block" aria-labelledby="odstepy">
      <h2 id="odstepy" class="reveal">
        Odstępy
      </h2>
      <ul class="spaces">
        {spaces.map((space) => (
          <li>
            <code>{space}</code>
            <span class={`bar ${space.slice(2)}`} aria-hidden="true" />
          </li>
        ))}
      </ul>
    </section>

    <section class="block" aria-labelledby="ruch">
      <h2 id="ruch" class="reveal">
        Ruch
      </h2>
      <ul class="motion">
        <li>Tytuł strony wjeżdża linia po linii przy wejściu (raz).</li>
        <li>Sekcje pojawiają się podczas przewijania.</li>
        <li>
          <a class="nudge" href="#ruch">
            Strzałka przesuwa się po najechaniu <span aria-hidden="true">→</span>
          </a>
        </li>
        <li>Przy ustawieniu „mniej ruchu” wszystko jest wyłączone.</li>
      </ul>
    </section>

    <section class="block" aria-labelledby="uklady">
      <h2 id="uklady" class="reveal">
        Układy
      </h2>
      <div class="layout-aside">
        <div class="demo">Treść główna (8 kolumn)</div>
        <aside class="demo">Panel boczny (4 kolumny, przyklejony)</aside>
      </div>
      <div class="layout-narrow demo narrow">Układ wąski: formularze i strony prawne</div>
    </section>

    <section class="block" aria-labelledby="tresc-artykulu">
      <h2 id="tresc-artykulu" class="reveal">
        Treść artykułu
      </h2>
      <RichText document={richTextSample} />
    </section>
  </div>
</Base>
