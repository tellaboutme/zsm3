---
import AudiencePanels from "../components/home/AudiencePanels.astro";
import EventTimeline from "../components/home/EventTimeline.astro";
import HomeHero from "../components/home/HomeHero.astro";
import NewsSection from "../components/home/NewsSection.astro";
import NumbersStrip from "../components/home/NumbersStrip.astro";
import ProfessionFinder from "../components/home/ProfessionFinder.astro";
import { news } from "../data/news.ts";
import Base from "../layouts/Base.astro";
import { latestNews } from "../lib/news.ts";

const [featured, ...recent] = latestNews(news, 5);
---

<Base
  title="Zespół Szkół Mechanicznych nr 3 w Krakowie"
  description="Technikum i szkoła branżowa w Nowej Hucie: 13 zawodów w informatyce, mechatronice, motoryzacji, lotnictwie i logistyce portów. Dzwonki, aktualności i terminarz szkoły."
>
  <div class="home">
    {featured !== undefined && <HomeHero featured={featured} />}
    <NumbersStrip />
    <ProfessionFinder />
    <NewsSection items={recent} />
    <EventTimeline />
    <AudiencePanels />
  </div>
</Base>

<script>
  import "../scripts/home.ts";
</script>

<style>
  .home {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-8);
    padding-bottom: var(--space-8);
  }
</style>
