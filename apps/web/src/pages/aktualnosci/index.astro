---
import NewsListing from "../../components/news/NewsListing.astro";
import Base from "../../layouts/Base.astro";
import { loadListing } from "../../lib/news-listing.ts";
import { newsReader, notFound } from "../../server/news.ts";

export const prerender = false;

const listing = await loadListing(newsReader(), {}, undefined);
if (listing === undefined) {
  return notFound();
}
---

<Base
  title="Aktualności — ZSM3"
  description="Wydarzenia, konkursy, projekty i ogłoszenia Zespołu Szkół Mechanicznych nr 3 w Krakowie."
  breadcrumbs={[{ label: "Aktualności" }]}
>
  <NewsListing listing={listing} base="/aktualnosci" heading="Aktualności" />
</Base>
