---
import NewsListing from "../../../components/news/NewsListing.astro";
import Base from "../../../layouts/Base.astro";
import { loadListing } from "../../../lib/news-listing.ts";
import { newsReader, notFound } from "../../../server/news.ts";

export const prerender = false;

const listing = await loadListing(newsReader(), {}, Astro.params["page"]);
if (listing === undefined) {
  return notFound();
}
const page = String(listing.page.page);
---

<Base
  title={`Aktualności, strona ${page} — ZSM3`}
  description="Starsze wiadomości Zespołu Szkół Mechanicznych nr 3 w Krakowie."
  breadcrumbs={[{ label: "Aktualności", href: "/aktualnosci" }, { label: `Strona ${page}` }]}
>
  <NewsListing listing={listing} base="/aktualnosci" heading="Aktualności" />
</Base>
