---
import NewsListing from "../../../components/news/NewsListing.astro";
import { news } from "../../../data/news/index.ts";
import Base from "../../../layouts/Base.astro";
import { newsYear, newsYears } from "../../../lib/news.ts";

interface Props {
  year: string;
}

export function getStaticPaths(): { params: { year: string }; props: Props }[] {
  return newsYears(news).map((year) => ({ params: { year }, props: { year } }));
}

const { year } = Astro.props;
const items = news.filter((item) => newsYear(item) === year);
---

<Base
  title={`Aktualności ${year} — ZSM3`}
  description={`Aktualności Zespołu Szkół Mechanicznych nr 3 z roku ${year}.`}
  breadcrumbs={[{ label: "Aktualności", href: "/aktualnosci" }, { label: year }]}
>
  <NewsListing
    items={items}
    page={1}
    base={`/aktualnosci/${year}`}
    heading={`Aktualności ${year}`}
    year={year}
  />
</Base>
