---
import NewsListing from "../../../../components/news/NewsListing.astro";
import Base from "../../../../layouts/Base.astro";
import { loadListing } from "../../../../lib/news-listing.ts";
import { newsReader, notFound } from "../../../../server/news.ts";

export const prerender = false;

const year = Astro.params["year"];
const listing = await loadListing(newsReader(), { year }, Astro.params["page"]);
if (listing === undefined || year === undefined) {
  return notFound();
}
const page = String(listing.page.page);
---

<Base
  title={`Aktualności ${year}, strona ${page} — ZSM3`}
  description={`Aktualności Zespołu Szkół Mechanicznych nr 3 z roku ${year}.`}
  breadcrumbs={[
    { label: "Aktualności", href: "/aktualnosci" },
    { label: year, href: `/aktualnosci/${year}` },
    { label: `Strona ${page}` },
  ]}
>
  <NewsListing
    listing={listing}
    base={`/aktualnosci/${year}`}
    heading={`Aktualności ${year}`}
    year={year}
  />
</Base>
