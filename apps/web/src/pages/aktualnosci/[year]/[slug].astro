---
import RichText from "../../../components/content/RichText.astro";
import NewsCard from "../../../components/news/NewsCard.astro";
import PageHead from "../../../components/PageHead.astro";
import Base from "../../../layouts/Base.astro";
import { longDate } from "../../../lib/calendar.ts";
import { loadArticle } from "../../../lib/news-listing.ts";
import { categoryHref, newsHref, newsYear } from "../../../lib/news.ts";
import { SITE_ORIGIN } from "../../../lib/seo.ts";
import { newsReader, notFound } from "../../../server/news.ts";

export const prerender = false;

const article = await loadArticle(newsReader(), Astro.params["year"], Astro.params["slug"]);
if (article === undefined) {
  return notFound();
}
const { item, category, related } = article;
const { newer, older } = article.neighbours;
---

<Base
  title={`${item.title} — ZSM3`}
  description={item.lead}
  structuredData={{
    "@context": "https://schema.org",
    "@type": "NewsArticle",
    headline: item.title,
    description: item.lead,
    datePublished: item.date,
    mainEntityOfPage: new URL(newsHref(item), SITE_ORIGIN).href,
  }}
  breadcrumbs={[
    { label: "Aktualności", href: "/aktualnosci" },
    { label: newsYear(item), href: `/aktualnosci/${newsYear(item)}` },
    { label: item.title },
  ]}
>
  <article class="article">
    <PageHead class="head headline" title={item.title} lead={item.lead}>
      <Fragment slot="meta">
        <a href={categoryHref(category)}>{category.name}</a>
        <time datetime={item.date}>{longDate(item.date)}</time>
      </Fragment>
    </PageHead>
    <div class="text">
      <RichText document={item.body} />
    </div>
    <footer class="tools">
      <button type="button" class="copy" data-copy-link hidden>
        Kopiuj link do artykułu
      </button>
      <p class="visually-hidden" role="status" data-copy-status></p>
      <a class="back nudge" href="/aktualnosci">
        <span aria-hidden="true">←</span> Wróć do listy
      </a>
    </footer>
  </article>
  <nav class="neighbours" aria-label="Sąsiednie artykuły">
    {newer !== undefined && (
      <a class="newer" href={newsHref(newer)} rel="prev">
        <span class="tag">← Nowszy</span>
        <span>{newer.title}</span>
      </a>
    )}
    {older !== undefined && (
      <a class="older" href={newsHref(older)} rel="next">
        <span class="tag">Starszy →</span>
        <span>{older.title}</span>
      </a>
    )}
  </nav>
  {related.length > 0 && (
    <section class="related" aria-labelledby="powiazane">
      <h2 id="powiazane">Przeczytaj też</h2>
      <ul>
        {related.map((entry) => (
          <li>
            <NewsCard item={entry} />
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>

<script>
  import "../../../scripts/article.ts";
</script>

<style>
  .article {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
    padding-block: var(--space-7);
  }

  .text {
    max-width: var(--measure);
  }

  .tools {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
    align-items: center;
  }

  .back {
    font-weight: 700;
  }

  .copy {
    min-height: var(--target);
    padding: var(--space-2) var(--space-4);
    border: var(--hairline) solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
    font-weight: 700;
    cursor: pointer;
  }

  .copy:hover {
    border-color: var(--ink);
  }

  .neighbours {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-4);
    padding-block: var(--space-5);
    border-block: var(--hairline) solid var(--line);
  }

  .neighbours a {
    display: grid;
    gap: var(--space-1);
    color: var(--ink);
    font-weight: 700;
    text-decoration: none;
  }

  .neighbours a:hover {
    color: var(--link);
  }

  .neighbours .tag {
    color: var(--ink-2);
  }

  .older {
    text-align: right;
  }

  .related {
    display: grid;
    gap: var(--space-5);
    padding-block: var(--space-7);
  }

  .related h2 {
    font-size: var(--step-3);
  }

  .related ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (width >= 64rem) {
    .article {
      grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
      column-gap: var(--space-7);
    }

    .head,
    .text {
      grid-column: 1;
    }

    .tools {
      position: sticky;
      top: calc(var(--header-height-compact) + var(--space-5));
      flex-direction: column;
      grid-row: 1 / span 2;
      grid-column: 2;
      align-items: start;
      align-self: start;
      padding-top: var(--space-5);
      border-top: var(--hairline) solid var(--line);
    }
  }
</style>
