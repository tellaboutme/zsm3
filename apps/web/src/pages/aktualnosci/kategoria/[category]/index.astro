---
import NewsListing from "../../../../components/news/NewsListing.astro";
import { news } from "../../../../data/news/index.ts";
import Base from "../../../../layouts/Base.astro";
import { categoryHref, newsCategories, type Category } from "../../../../lib/news.ts";

interface Props {
  category: Category;
}

export function getStaticPaths(): { params: { category: string }; props: Props }[] {
  return newsCategories(news).map((category) => ({
    params: { category: category.slug },
    props: { category },
  }));
}

const { category } = Astro.props;
const items = news.filter((item) => item.category === category.name);
---

<Base
  title={`${category.name} — Aktualności — ZSM3`}
  description={`Aktualności z kategorii ${category.name}.`}
  breadcrumbs={[{ label: "Aktualności", href: "/aktualnosci" }, { label: category.name }]}
>
  <NewsListing
    items={items}
    page={1}
    base={categoryHref(category)}
    heading={category.name}
    category={category.slug}
  />
</Base>
