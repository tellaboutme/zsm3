---
import NewsListing from "../../../../../components/news/NewsListing.astro";
import Base from "../../../../../layouts/Base.astro";
import { loadListing } from "../../../../../lib/news-listing.ts";
import { categoryHref } from "../../../../../lib/news.ts";
import { newsReader, notFound } from "../../../../../server/news.ts";

export const prerender = false;

const listing = await loadListing(
  newsReader(),
  { category: Astro.params["category"] },
  Astro.params["page"],
);
const category = listing?.category;
if (listing === undefined || category === undefined) {
  return notFound();
}
const page = String(listing.page.page);
---

<Base
  title={`${category.name}, strona ${page} — Aktualności — ZSM3`}
  description={`Aktualności z kategorii ${category.name}.`}
  breadcrumbs={[
    { label: "Aktualności", href: "/aktualnosci" },
    { label: category.name, href: categoryHref(category) },
    { label: `Strona ${page}` },
  ]}
>
  <NewsListing listing={listing} base={categoryHref(category)} heading={category.name} />
</Base>
