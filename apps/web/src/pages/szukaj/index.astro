---
import SearchBox from "../../components/SearchBox.astro";
import SearchResults from "../../components/SearchResults.astro";
import Base from "../../layouts/Base.astro";

export const prerender = false;
---

<Base
  title="Szukaj — ZSM3"
  description="Wyszukiwarka stron, kierunków, klas, kontaktów, aktualności, dokumentów i terminów Zespołu Szkół Mechanicznych nr 3."
  breadcrumbs={[{ label: "Szukaj" }]}
>
  <div class="search-page">
    <header class="intro">
      <h1>
        <span class="rise">
          <span>Szukaj</span>
        </span>
      </h1>
      <SearchBox id="szukaj-strona" label="Wpisz słowo, np. dzwonki, legitymacja, informatyk" />
    </header>
    <SearchResults syncAddress />
    <noscript>
      <p class="note">
        Wyszukiwarka działa w przeglądarce z włączonym JavaScriptem. Wszystkie strony znajdziesz też
        na <a href="/mapa-strony">mapie strony</a>.
      </p>
    </noscript>
  </div>
</Base>

<style>
  .search-page {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
    max-width: 52rem;
    padding-block: var(--space-7) var(--space-8);
  }

  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
  }

  h1 {
    font-size: var(--step-title);
    font-stretch: var(--stretch-wide);
  }

  .note {
    color: var(--ink-2);
  }
</style>
